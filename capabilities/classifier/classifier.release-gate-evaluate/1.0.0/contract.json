  "summary": "Evaluate a classifier release gate from labeled outcomes.",
  "use_cases": [
    {
      "happy": true,
      "input_example": {
        "cases": [
          {
            "contains_positive": true,
            "positive_detected": true
          },
          {
            "contains_positive": true,
            "positive_detected": true
          },
          {
            "contains_positive": false,
            "positive_detected": false
          }
        ],
        "policy": {
          "maximum_false_negative_millis": 0,
          "minimum_positive_cases": 2,
          "version": "release-gate-1"
        }
      },
      "output_example": {
        "decision": "approve_for_policy",
        "false_negative_millis": 0,
        "false_negatives": 0,
        "positive_cases": 2,
        "reason": "release_gate_passed"
      },
      "persona_ref": "classifier-steward",
      "scenario": "As a classifier steward, I want a candidate with sufficient labeled positive-case coverage and zero false negatives approved so that a separate host can rely on that policy gate."
    },
    {
      "happy": false,
      "input_example": {
        "cases": [
          {
            "contains_positive": true,
            "positive_detected": false
          },
          {
            "contains_positive": true,
            "positive_detected": true
          }
        ],
        "policy": {
          "maximum_false_negative_millis": 0,
          "minimum_positive_cases": 2,
          "version": "release-gate-1"
        }
      },
      "output_example": {
        "decision": "reject",
        "false_negative_millis": 500,
        "false_negatives": 1,
        "positive_cases": 2,
        "reason": "false_negative_limit_exceeded"
      },
      "persona_ref": "classifier-steward",
      "scenario": "As a classifier steward, I want a candidate with missed positive cases rejected so that unsafe classifier behavior cannot be promoted."
    },
