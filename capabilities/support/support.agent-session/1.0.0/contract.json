  "use_cases": [
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want to put an agent handling session bound to an active ticket, so that my ownership of the live ticket survives across runtime invocations.",
      "input_example": {
        "action": "put",
        "session": {
          "session_id": "s-1",
          "agent_id": "agent-1",
          "active_ticket_id": "t-1",
          "started_at": "2026-09-08T20:00:00Z"
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "session": {
          "session_id": "s-1",
          "agent_id": "agent-1",
          "active_ticket_id": "t-1",
          "started_at": "2026-09-08T20:00:00Z"
        },
        "evaluation_trace": [
          "put session"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "client-developer",
      "scenario": "As a client developer, I want to get the durable agent session, so that my support client can restore which agent is handling which ticket after reconnect.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "session": {
          "session_id": "s-1",
          "agent_id": "agent-1",
          "active_ticket_id": "t-1",
          "started_at": "2026-09-08T20:00:00Z"
        },
        "evaluation_trace": [
          "got session"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "operations-operator",
      "scenario": "As an operations operator, I want to delete an agent session when the handler signs off, so that ticket ownership is not left pointing at an idle session.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "deleted session"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "client-developer",
      "scenario": "As a client developer, I want get to report not_found when no session exists, so that my client can start a fresh handling session instead of assuming a live agent.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "not_found",
        "found": false,
        "evaluation_trace": [
          "session absent"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want put without a session object rejected as invalid_input, so that incomplete session writes cannot corrupt host state.",
      "input_example": {
        "action": "put"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed: session object required for put"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "operations-operator",
      "scenario": "As an operations operator, I want an unknown action rejected as invalid_action, so that unsupported verbs fail closed before touching the store.",
      "input_example": {
        "action": "list"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_action",
        "evaluation_trace": [
          "action must be get, put, or delete"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "client-developer",
      "scenario": "As a client developer, I want host store failures surfaced as host_error, so that I can retry session persistence instead of treating a failed put as success.",
      "input_example": {
        "action": "put",
        "session": {
          "session_id": "s-err",
          "agent_id": "agent-1",
          "active_ticket_id": "t-1",
          "started_at": "2026-09-08T20:00:00Z"
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "host_error",
        "evaluation_trace": [
          "state_put failed"
        ]
      }
    }
  ]
