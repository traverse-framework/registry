  "summary": "Durable support ticket workspace retained via host managed state.",
  "description": "Stateful put/get/delete for a single fixed-schema workspace record (ticket_id, status, assignee_id, tags[]). Resource identity lives inside the value; the relative host key is always workspace. Uses traverse_host state_put/state_get/state_delete. Browser targets are excluded.",
  "emits": [],
  "side_effects": [
    {
      "description": "Validates action envelope and workspace fields in memory",
      "kind": "memory_only"
    },
    {
      "description": "Reads or mutates host-managed workspace state via traverse_host state_*",
      "kind": "memory_only"
    }
  ],
