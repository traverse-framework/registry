  "use_cases": [
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want to put a ticket workspace with assignee and tags, so that active incident ownership is retained across invocations.",
      "input_example": {
        "action": "put",
        "workspace": {
          "ticket_id": "t-1",
          "status": "open",
          "assignee_id": "agent-1",
          "tags": [
            "billing",
            "p1"
          ]
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "workspace": {
          "ticket_id": "t-1",
          "status": "open",
          "assignee_id": "agent-1",
          "tags": [
            "billing",
            "p1"
          ]
        },
        "evaluation_trace": [
          "put workspace"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "client-developer",
      "scenario": "As a client developer, I want to get the durable ticket workspace, so that my support UI can restore the current ticket context after a reconnect.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "workspace": {
          "ticket_id": "t-1",
          "status": "open",
          "assignee_id": "agent-1",
          "tags": [
            "billing"
          ]
        },
        "evaluation_trace": [
          "got workspace"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "operations-operator",
      "scenario": "As an operations operator, I want to delete a ticket workspace when the incident is closed out, so that stale assignee context does not linger in managed state.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "deleted workspace"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "client-developer",
      "scenario": "As a client developer, I want get to report not_found when no workspace exists, so that my client can prompt for a fresh ticket bind instead of showing stale data.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "not_found",
        "found": false,
        "evaluation_trace": [
          "workspace absent"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want put without a workspace object rejected as invalid_input, so that incomplete writes cannot corrupt host state.",
      "input_example": {
        "action": "put"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed: workspace object required for put"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "operations-operator",
      "scenario": "As an operations operator, I want an unknown action rejected as invalid_action, so that unsupported verbs fail closed before touching the store.",
      "input_example": {
        "action": "list"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_action",
        "evaluation_trace": [
          "action must be get, put, or delete"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "client-developer",
      "scenario": "As a client developer, I want host store failures surfaced as host_error, so that I can retry or escalate instead of treating a failed put as success.",
      "input_example": {
        "action": "put",
        "workspace": {
          "ticket_id": "t-err",
          "status": "open",
          "assignee_id": "agent-1",
          "tags": []
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "host_error",
        "evaluation_trace": [
          "state_put failed"
        ]
      }
    }
  ]
