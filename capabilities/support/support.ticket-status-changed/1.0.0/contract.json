  "summary": "Built-in support ticket status state machine with governed emit.",
  "description": "Evaluates ticket status transitions against a fixed support graph: open\u2192in_progress|waiting_customer|resolved|cancelled; in_progress\u2192waiting_customer|resolved|cancelled; waiting_customer\u2192in_progress|resolved|cancelled; resolved\u2192closed|open; closed and cancelled are terminal. On accepted transitions emits support.ticket.status-changed@1.0.0. Does not persist tickets.",
  "event_trigger": "support.ticket-status-changed.triggered",
  "emits": [
    {
      "event_id": "support.ticket.status-changed",
      "version": "1.0.0"
    }
  ],
  "side_effects": [
    {
      "description": "Pure ticket status state-machine evaluation",
      "kind": "memory_only"
    },
    {
      "description": "Emits support.ticket.status-changed@1.0.0 via traverse_host::emit_event when accepted (ok)",
      "kind": "event_emission"
    }
  ],
  "preconditions": [
    {
      "id": "statuses-valid",
      "description": "current and requested status must be known ticket statuses"
    }
  ],
  "provenance": {
    "source": "greenfield",
    "author": "traverse/registry",
    "created_at": "2026-09-08T00:00:00Z",
    "spec_ref": "001-registry-foundation",
    "adr_refs": [],
    "exception_refs": []
  },
  "artifact": {
    "digest": "sha256:5451557b0ed0767b1e98a2af38b0d059446f454fa76554d1c10b46b4bba91f92",
    "url": "https://github.com/traverse-framework/registry/releases/download/artifacts/support.ticket-status-changed-1.0.0/support-ticket-status-changed.wasm"
  },
  "inputs": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket_id",
        "current_status",
        "requested_status",
        "actor_id"
      ],
      "properties": {
        "ticket_id": {
          "type": "string"
        },
        "current_status": {
          "type": "string",
          "enum": [
            "open",
            "in_progress",
            "waiting_customer",
            "resolved",
            "closed",
            "cancelled"
          ]
        },
        "requested_status": {
          "type": "string",
          "enum": [
            "open",
            "in_progress",
            "waiting_customer",
            "resolved",
            "closed",
            "cancelled"
          ]
        },
        "actor_id": {
          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "new_status",
        "reason_code"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "new_status": {
          "type": "string"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "ok",
            "illegal_transition",
            "invalid_status"
          ]
        },
        "evaluation_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "use_cases": [
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want open \u2192 in_progress accepted, so that ownership of active work is visible.",
      "input_example": {
        "ticket_id": "t-1",
        "current_status": "open",
        "requested_status": "in_progress",
        "actor_id": "agent-1"
      },
      "output_example": {
        "allowed": true,
        "new_status": "in_progress",
        "reason_code": "ok",
        "evaluation_trace": [
          "open \u2192 in_progress is allowed"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want in_progress \u2192 waiting_customer accepted, so that customer blockers are explicit.",
      "input_example": {
        "ticket_id": "t-1b",
        "current_status": "in_progress",
        "requested_status": "waiting_customer",
        "actor_id": "agent-1"
      },
      "output_example": {
        "allowed": true,
        "new_status": "waiting_customer",
        "reason_code": "ok",
        "evaluation_trace": [
          "in_progress \u2192 waiting_customer is allowed"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want waiting_customer \u2192 resolved accepted, so that answered tickets can close the loop.",
      "input_example": {
        "ticket_id": "t-1c",
        "current_status": "waiting_customer",
        "requested_status": "resolved",
        "actor_id": "agent-1"
      },
      "output_example": {
        "allowed": true,
        "new_status": "resolved",
        "reason_code": "ok",
        "evaluation_trace": [
          "waiting_customer \u2192 resolved is allowed"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want resolved \u2192 closed accepted, so that confirmed resolutions leave the queue.",
      "input_example": {
        "ticket_id": "t-1d",
        "current_status": "resolved",
        "requested_status": "closed",
        "actor_id": "agent-1"
      },
      "output_example": {
        "allowed": true,
        "new_status": "closed",
        "reason_code": "ok",
        "evaluation_trace": [
          "resolved \u2192 closed is allowed"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want resolved \u2192 open accepted, so that reopen is an explicit transition.",
      "input_example": {
        "ticket_id": "t-2",
        "current_status": "resolved",
        "requested_status": "open",
        "actor_id": "agent-1"
      },
      "output_example": {
        "allowed": true,
        "new_status": "open",
        "reason_code": "ok",
        "evaluation_trace": [
          "resolved \u2192 open is allowed"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want open \u2192 cancelled accepted, so that spam or duplicates can exit without fake resolution.",
      "input_example": {
        "ticket_id": "t-2b",
        "current_status": "open",
        "requested_status": "cancelled",
        "actor_id": "agent-1"
      },
      "output_example": {
        "allowed": true,
        "new_status": "cancelled",
        "reason_code": "ok",
        "evaluation_trace": [
          "open \u2192 cancelled is allowed"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want closed \u2192 open rejected, so that closed tickets stay terminal.",
      "input_example": {
        "ticket_id": "t-3",
        "current_status": "closed",
        "requested_status": "open",
        "actor_id": "agent-1"
      },
      "output_example": {
        "allowed": false,
        "new_status": "closed",
        "reason_code": "illegal_transition",
        "evaluation_trace": [
          "closed has no allowed transition to open"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want missing actor_id rejected with invalid_status, so that incomplete requests fail closed.",
      "input_example": {
        "ticket_id": "t-5",
        "current_status": "open",
        "requested_status": "in_progress",
        "actor_id": ""
      },
      "output_example": {
        "allowed": false,
        "new_status": "open",
        "reason_code": "invalid_status",
        "evaluation_trace": [
          "precondition failed: required fields missing"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want cancelled \u2192 open rejected, so that cancelled tickets stay terminal.",
      "input_example": {
        "ticket_id": "t-6",
        "current_status": "cancelled",
        "requested_status": "open",
        "actor_id": "agent-1"
      },
      "output_example": {
        "allowed": false,
        "new_status": "cancelled",
        "reason_code": "illegal_transition",
        "evaluation_trace": [
          "cancelled has no allowed transition to open"
        ]
      }
    }
  ]
}
