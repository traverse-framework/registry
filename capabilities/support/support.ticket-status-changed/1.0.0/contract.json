  "id": "support.ticket-status-changed",
  "namespace": "support",
  "name": "ticket-status-changed",
  "version": "1.0.0",
  "authoring": {
    "method": "llm-assisted",
    "source_revision": "feat/service-type-fill-wave1",
    "test_evidence": "capability-src/support-ticket-status-changed cargo test (6 passing)",
