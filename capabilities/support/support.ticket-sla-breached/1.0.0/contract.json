  "summary": "Decide whether a support ticket SLA is breached after priority grace.",
  "description": "Given ticket_id, due_at, now (unix seconds), and priority (low|normal|high|urgent), computes breach as now > due_at + priority_grace where urgent/high=0s, normal=300s, low=900s. Emits support.ticket.sla-breached@1.0.0 only when breached. Pure decision; does not persist tickets or clocks.",
  "event_trigger": "support.ticket-sla-breached.triggered",
  "emits": [
    {
      "event_id": "support.ticket.sla-breached",
      "version": "1.0.0"
    }
  ],
  "side_effects": [
    {
      "description": "Pure SLA breach decision",
      "kind": "memory_only"
    },
    {
      "description": "Emits support.ticket.sla-breached@1.0.0 via traverse_host::emit_event when breached",
      "kind": "event_emission"
    }
  ],
  "preconditions": [
    {
      "id": "times-present",
      "description": "due_at and now must be non-negative unix seconds"
    },
    {
      "id": "priority-known",
      "description": "priority must be low|normal|high|urgent"
    }
  ],
  "provenance": {
    "source": "greenfield",
    "author": "traverse/registry",
    "created_at": "2026-09-08T00:00:00Z",
    "spec_ref": "001-registry-foundation",
    "adr_refs": [],
