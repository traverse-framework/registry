  },
  "inputs": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket_id",
        "due_at",
        "now",
        "priority"
      ],
      "properties": {
        "ticket_id": {
          "type": "string"
        },
        "due_at": {
          "type": "integer"
        },
        "now": {
          "type": "integer"
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ]
        }
      }
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breached",
        "overdue_seconds",
        "reason_code"
      ],
      "properties": {
        "breached": {
          "type": "boolean"
        },
        "overdue_seconds": {
          "type": "integer"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "breached",
            "within_sla",
            "invalid_input"
          ]
        },
        "evaluation_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "use_cases": [
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want high-priority overdue tickets marked breached immediately, so that paging fires without grace.",
      "input_example": {
        "ticket_id": "t-1",
        "due_at": 1000,
        "now": 1001,
        "priority": "high"
      },
      "output_example": {
        "breached": true,
        "overdue_seconds": 1,
        "reason_code": "breached",
        "evaluation_trace": [
          "SLA breached after priority grace"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want urgent overdue tickets marked breached with zero grace, so that SEV pages are not delayed.",
      "input_example": {
        "ticket_id": "t-1u",
        "due_at": 1000,
        "now": 1005,
        "priority": "urgent"
      },
      "output_example": {
        "breached": true,
        "overdue_seconds": 5,
        "reason_code": "breached",
        "evaluation_trace": [
          "SLA breached after priority grace"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want normal priority still within 300s grace reported within_sla, so that brief delays do not false-alarm.",
      "input_example": {
        "ticket_id": "t-2",
        "due_at": 1000,
        "now": 1200,
        "priority": "normal"
      },
      "output_example": {
        "breached": false,
        "overdue_seconds": 0,
        "reason_code": "within_sla",
        "evaluation_trace": [
          "now is at or before due_at + priority grace"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want normal priority past grace marked breached, so that real overdue work surfaces.",
      "input_example": {
        "ticket_id": "t-3",
        "due_at": 1000,
        "now": 1400,
        "priority": "normal"
      },
      "output_example": {
        "breached": true,
        "overdue_seconds": 100,
        "reason_code": "breached",
        "evaluation_trace": [
          "SLA breached after priority grace"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want low priority within 900s grace reported within_sla, so that backlog noise stays quiet.",
      "input_example": {
        "ticket_id": "t-4",
        "due_at": 1000,
        "now": 1800,
        "priority": "low"
      },
      "output_example": {
        "breached": false,
        "overdue_seconds": 0,
        "reason_code": "within_sla",
        "evaluation_trace": [
          "now is at or before due_at + priority grace"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "incident-responder",
      "scenario": "As an incident responder, I want missing fields rejected with invalid_input, so that incomplete probes cannot emit breaches.",
      "input_example": {
        "ticket_id": "t-5"
      },
      "output_example": {
        "breached": false,
        "overdue_seconds": 0,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed: ticket_id and priority required"
        ]
      }
    }
  ]
