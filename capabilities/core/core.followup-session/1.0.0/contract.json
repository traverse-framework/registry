  "summary": "Put, get, or delete a follow-up working session via host managed state.",
  "description": "Stateful store for a follow-up working session (session_id, agenda_item_ids[], cursor) persisted under the fixed state_schema key `session` via traverse_host::{state_put,state_get,state_delete}. Resource identity lives inside the value. Does not emit events.",
  "emits": [],
  "side_effects": [
    {
      "description": "Reads and writes host DataStore persistence for key session via state_get/state_put/state_delete",
      "kind": "memory_only"
    }
  ],
  "preconditions": [
    {
      "id": "action-present",
      "description": "action must be one of get, put, delete"
    },
    {
      "id": "put-session-complete",
      "description": "put requires session with session_id, agenda_item_ids array, and integer cursor"
    }
  ],
  "risk": {
    "effect_class": "state_write",
    "determinism_class": "deterministic",
