  "use_cases": [
    {
      "happy": true,
      "persona_ref": "meeting-organizer",
      "scenario": "As a meeting organizer, I want to put a follow-up session with agenda ids and cursor, so that the working set is durable across devices.",
      "input_example": {
        "action": "put",
        "session": {
          "session_id": "sess-1",
          "agenda_item_ids": [
            "a1",
            "a2"
          ],
          "cursor": 0
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "session": {
          "session_id": "sess-1",
          "agenda_item_ids": [
            "a1",
            "a2"
          ],
          "cursor": 0
        },
        "evaluation_trace": [
          "put session"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "collaboration-product-owner",
      "scenario": "As a collaboration product owner, I want to get the current follow-up session, so that facilitators resume at the right agenda cursor.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "session": {
          "session_id": "sess-1",
          "agenda_item_ids": [
            "a1"
          ],
          "cursor": 1
        },
        "evaluation_trace": [
          "got session"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "note-taking-app-developer",
      "scenario": "As a note-taking app developer, I want to delete a follow-up session when the meeting closes, so that stale cursors do not resurface.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "deleted session"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "meeting-organizer",
      "scenario": "As a meeting organizer, I want get to report not_found when no session is stored, so that empty state is explicit.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "not_found",
        "found": false,
        "evaluation_trace": [
          "session absent"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "collaboration-platform-engineer",
      "scenario": "As a collaboration platform engineer, I want put without a cursor rejected, so that incomplete session payloads cannot persist.",
      "input_example": {
        "action": "put",
        "session": {
          "session_id": "sess-1",
          "agenda_item_ids": []
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed: session.cursor required as integer"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "note-taking-app-developer",
      "scenario": "As a note-taking app developer, I want unknown actions rejected, so that clients cannot invent session verbs.",
      "input_example": {
        "action": "list"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_action",
        "evaluation_trace": [
          "action must be get, put, or delete"
        ]
      }
    }
