  "use_cases": [
    {
      "happy": true,
      "persona_ref": "collaboration-product-owner",
      "scenario": "As a collaboration product owner, I want to put an action-item record into durable store, so that ownership and status survive across sessions.",
      "input_example": {
        "action": "put",
        "record": {
          "id": "ai-1",
          "title": "Ship Wave 2",
          "status": "open",
          "owner_id": "user-ada"
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "record": {
          "id": "ai-1",
          "title": "Ship Wave 2",
          "status": "open",
          "owner_id": "user-ada"
        },
        "evaluation_trace": [
          "put record"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "note-taking-app-developer",
      "scenario": "As a note-taking app developer, I want to get a previously stored action-item record, so that my UI can render the current title and owner.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "record": {
          "id": "ai-1",
          "title": "Ship Wave 2",
          "status": "open",
          "owner_id": "user-ada"
        },
        "evaluation_trace": [
          "got record"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "collaboration-platform-engineer",
      "scenario": "As a collaboration platform engineer, I want to delete the stored action-item record, so that completed work does not linger in managed state.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "deleted record"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "note-taking-app-developer",
      "scenario": "As a note-taking app developer, I want get to fail closed when no record exists, so that absent state is explicit.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "not_found",
        "found": false,
        "evaluation_trace": [
          "record absent"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "collaboration-product-owner",
      "scenario": "As a collaboration product owner, I want put with an incomplete record rejected, so that partial writes cannot corrupt the store.",
      "input_example": {
        "action": "put",
        "record": {
          "id": "ai-1",
          "title": "",
          "status": "open",
          "owner_id": "user-ada"
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed: record.id/title/status/owner_id required"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "collaboration-platform-engineer",
      "scenario": "As a collaboration platform engineer, I want unknown actions rejected, so that clients cannot invent store verbs.",
      "input_example": {
        "action": "list"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_action",
        "evaluation_trace": [
          "action must be get, put, or delete"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "collaboration-platform-engineer",
      "scenario": "As a collaboration platform engineer, I want host persistence failures surfaced as host_error, so that callers can fail closed when DataStore is unavailable.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "host_error",
        "evaluation_trace": [
          "state_delete failed"
        ]
      }
    }
  ]
