  "summary": "Put, get, or delete a durable action-item record via host managed state.",
  "description": "Stateful store for a single action-item record (id, title, status, owner_id) persisted under the fixed state_schema key `record` via traverse_host::{state_put,state_get,state_delete}. Resource identity lives inside the value. Does not emit events.",
  "emits": [],
  "side_effects": [
    {
      "description": "Reads and writes host DataStore persistence for key record via state_get/state_put/state_delete",
      "kind": "memory_only"
    }
  ],
  "preconditions": [
    {
      "id": "action-present",
      "description": "action must be one of get, put, delete"
    },
    {
      "id": "put-record-complete",
      "description": "put requires record with non-empty id, title, status, and owner_id"
    }
  ],
  "risk": {
    "effect_class": "state_write",
    "determinism_class": "deterministic",
    "reliability": {
      "idempotency_required": true,
      "retryable": true,
      "compensation_available": false
    }
  },
  "provenance": {
    "source": "greenfield",
    "author": "traverse/registry",
