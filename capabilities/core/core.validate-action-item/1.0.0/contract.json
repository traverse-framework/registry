              "default": false,
              "type": "boolean"
            },
            "duplicate_check": {
              "enum": [
                "none",
                "title",
                "title_and_owner"
              ],
              "type": "string"
            },
            "require_due_date": {
              "default": false,
              "type": "boolean"
            },
            "require_owner": {
              "default": true,
              "type": "boolean"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "version"
          ],
          "type": "object"
        }
      },
      "required": [
        "action_item",
        "validation_config",
        "reference_date"
      ],
      "type": "object"
    }
