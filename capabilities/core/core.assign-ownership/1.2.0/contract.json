{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "core.assign-ownership",
  "namespace": "core",
  "name": "assign-ownership",
  "version": "1.2.0",
  "lifecycle": "active",
  "owner": {
    "team": "loop",
    "contact": "founders@loop.dev"
  },
  "summary": "Resolves and records clear ownership for an action item (single accountable person).",
  "description": "Resolves a suggested owner against workspace members (id, email, name) and applies ownership_config.fallback when unresolved. Requires action_item_id so downstream consumers can correlate the governed ownership-assigned event.\n\nImplemented and smoke-tested matrix (use_cases):\n- name_match \u2192 ok\n- email_match \u2192 ok\n- null suggestion with fallback=creator \u2192 ok\n- unknown suggestion with fallback=fail \u2192 unresolved\n- inactive member with require_active_member \u2192 inactive_member\n- invalid fallback value \u2192 config_error\n- unknown suggestion with fallback=unassigned \u2192 ok (owner_id null)\n\nOn reason_code=ok with a non-null owner_id, the WASM guest calls traverse_host::emit_event for core.action-item.ownership-assigned@1.0.0 with payload {action_item_id, owner_id, resolution_method}.\n\nKnown limitations (intentional in 1.2.0):\n- Does not mutate storage or notify members; callers persist the decision\n- Unassigned ok paths (owner_id null) do not emit",
  "use_cases": [
    {
      "scenario": "As a system, I want a name match to resolve to a canonical user id, so that ownership is unambiguous downstream.",
      "input_example": {
        "suggested_owner": "Ada Lovelace",
        "creator_id": "user-carol",
        "workspace_members": [
          {
            "id": "user-ada",
            "name": "Ada Lovelace",
            "email": "ada@loop.dev"
          },
          {
            "id": "user-bob",
            "name": "Bob Smith",
            "email": "bob@loop.dev"
          }
        ],
        "ownership_config": {
          "version": "1.0",
          "fallback": "creator",
          "require_active_member": true
        },
        "action_item_id": "item-001"
      },
      "output_example": {
        "owner_id": "user-ada",
        "resolution_method": "name_match",
        "reason_code": "ok",
        "evaluation_trace": [
          "exact name match on Ada Lovelace"
        ]
      },
      "happy": true,
      "persona_ref": "runtime-engineer"
    },
    {
      "scenario": "As a system, I want an email suggestion to resolve by email, so that directory matches stay deterministic.",
      "input_example": {
        "suggested_owner": "bob@loop.dev",
        "creator_id": "user-carol",
        "workspace_members": [
          {
            "id": "user-ada",
            "name": "Ada Lovelace",
            "email": "ada@loop.dev"
          },
          {
            "id": "user-bob",
            "name": "Bob Smith",
            "email": "bob@loop.dev"
          }
        ],
        "ownership_config": {
          "version": "1.0",
          "fallback": "creator",
          "require_active_member": true
        },
        "action_item_id": "item-002"
      },
      "output_example": {
        "owner_id": "user-bob",
        "resolution_method": "email_match",
        "reason_code": "ok",
        "evaluation_trace": [
          "email match on bob@loop.dev"
        ]
      },
      "happy": true,
      "persona_ref": "runtime-engineer"
    },
    {
      "scenario": "As a system, I want a null suggestion to fall back to the creator, so that every item still has an owner path.",
      "input_example": {
        "suggested_owner": null,
        "creator_id": "user-carol",
        "workspace_members": [
          {
            "id": "user-carol",
            "name": "Carol Jones",
            "email": "carol@loop.dev"
          }
        ],
        "ownership_config": {
          "version": "1.0",
          "fallback": "creator",
          "require_active_member": true
        },
        "action_item_id": "item-003"
      },
      "output_example": {
        "owner_id": "user-carol",
        "resolution_method": "fallback_creator",
        "reason_code": "ok",
        "evaluation_trace": [
          "suggested_owner null",
          "fallback=creator"
        ]
      },
      "happy": true,
      "persona_ref": "meeting-organizer"
    },
    {
      "scenario": "As a system, I want an unknown suggestion to fail closed when fallback is fail, so that unresolved owners never silently pass.",
      "input_example": {
        "suggested_owner": "Unknown Person",
        "creator_id": "user-carol",
        "workspace_members": [
          {
            "id": "user-ada",
            "name": "Ada Lovelace",
            "email": "ada@loop.dev"
          }
        ],
        "ownership_config": {
          "version": "1.0",
          "fallback": "fail",
          "require_active_member": true
        },
        "action_item_id": "item-004"
      },
      "output_example": {
        "owner_id": null,
        "resolution_method": "unresolved",
        "reason_code": "unresolved",
        "evaluation_trace": [
          "no member match for suggestion",
          "fallback=fail"
        ]
      },
      "happy": false,
      "persona_ref": "runtime-engineer"
    },
    {
      "scenario": "As a system, I want an inactive member match rejected with inactive_member when require_active_member is true, so that inactive accounts cannot own work.",
      "input_example": {
        "suggested_owner": "user-ada",
        "creator_id": "user-carol",
        "workspace_members": [
          {
            "id": "user-ada",
            "name": "Ada Lovelace",
            "email": "ada@loop.dev",
            "active": false
          }
        ],
        "ownership_config": {
          "version": "1.0",
          "fallback": "fail",
          "require_active_member": true
        },
        "action_item_id": "item-005"
      },
      "output_example": {
        "owner_id": null,
        "resolution_method": "unresolved",
        "reason_code": "inactive_member",
        "evaluation_trace": [
          "matched inactive member"
        ]
      },
      "happy": false,
      "persona_ref": "runtime-engineer"
    },
    {
      "scenario": "As a system, I want an invalid fallback value rejected with config_error, so that misconfiguration is visible immediately.",
      "input_example": {
        "suggested_owner": "Ada Lovelace",
        "creator_id": "user-carol",
        "workspace_members": [
          {
            "id": "user-ada",
            "name": "Ada Lovelace",
            "email": "ada@loop.dev"
          },
          {
            "id": "user-bob",
            "name": "Bob Smith",
            "email": "bob@loop.dev"
          }
        ],
        "ownership_config": {
          "version": "1.0",
          "fallback": "bogus",
          "require_active_member": true
        },
        "action_item_id": "item-006"
      },
      "output_example": {
        "owner_id": null,
        "resolution_method": "config_error",
        "reason_code": "config_error",
        "evaluation_trace": [
          "invalid fallback"
        ]
      },
      "happy": false,
      "persona_ref": "runtime-engineer"
    },
    {
      "scenario": "As a system, I want unknown suggestions to resolve as unassigned when fallback is unassigned, so that callers can prompt for an owner later.",
      "input_example": {
        "suggested_owner": "Unknown Person",
        "creator_id": "user-carol",
        "workspace_members": [
          {
            "id": "user-ada",
            "name": "Ada Lovelace",
            "email": "ada@loop.dev"
          }
        ],
        "ownership_config": {
          "version": "1.0",
          "fallback": "unassigned",
          "require_active_member": true
        },
        "action_item_id": "item-007"
      },
      "output_example": {
        "owner_id": null,
        "resolution_method": "fallback_unassigned",
        "reason_code": "ok",
        "evaluation_trace": [
          "no member match for suggestion",
          "fallback=unassigned"
        ]
      },
      "happy": true,
      "persona_ref": "collaboration-product-owner"
    }
  ],
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "action_item_id",
        "suggested_owner",
        "workspace_members",
        "ownership_config"
      ],
      "properties": {
        "suggested_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "creator_id": {
          "type": "string"
        },
        "workspace_members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "active": {
                "type": "boolean"
              }
            }
          }
        },
        "ownership_config": {
          "type": "object",
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "fallback": {
              "type": "string",
              "enum": [
                "creator",
                "unassigned",
                "fail"
              ]
            },
            "require_active_member": {
              "type": "boolean"
            }
          }
        },
        "action_item_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "owner_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution_method": {
          "type": "string"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "ok",
            "unresolved",
            "inactive_member",
            "config_error"
          ]
        },
        "evaluation_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "preconditions": [],
  "postconditions": [
    {
      "id": "deterministic",
      "description": "Identical inputs produce identical outputs"
    }
  ],
  "side_effects": [
