  "summary":"Create a deterministic, connector-neutral audio transformation plan.",
  "description":"Validates opaque source references, media type, and target PCM format choices before a host codec executes a transformation. It never reads bytes, invokes a connector, accesses a filesystem, selects a model, or knows an application or workflow.",
  "use_cases":[
    {"scenario":"As an audio operator, I want a valid target PCM format represented as a portable plan, so that a compatible codec host can execute it.","input_example":{"source_artifact_ref":"asset:sha256:source-17","source_media_type":"audio/flac","target_sample_rate_hz":48000,"target_channel_count":1,"target_encoding":"pcm_s16le","idempotency_key":"transform-source-17"},"output_example":{"operation":"transform","source_artifact_ref":"asset:sha256:source-17","target_sample_rate_hz":48000,"target_channel_count":1,"target_encoding":"pcm_s16le","idempotency_key":"transform-source-17","result_class":"planned"},"happy":true,"persona_ref":"audio-operator"},
    {"scenario":"As an audio operator, I want 24-bit PCM accepted, so that a supported target encoding can be planned.","input_example":{"source_artifact_ref":"asset:sha256:source-17","source_media_type":"audio/flac","target_sample_rate_hz":48000,"target_channel_count":1,"target_encoding":"pcm_s24le","idempotency_key":"transform-source-17-24"},"output_example":{"operation":"transform","source_artifact_ref":"asset:sha256:source-17","target_sample_rate_hz":48000,"target_channel_count":1,"target_encoding":"pcm_s24le","idempotency_key":"transform-source-17-24","result_class":"planned"},"happy":true,"persona_ref":"audio-operator"},
    {"scenario":"As an audio operator, I want 32-bit float PCM accepted, so that a supported target encoding can be planned deterministically.","input_example":{"source_artifact_ref":"asset:sha256:source-17","source_media_type":"audio/flac","target_sample_rate_hz":48000,"target_channel_count":1,"target_encoding":"pcm_f32le","idempotency_key":"transform-source-17-f32"},"output_example":{"operation":"transform","source_artifact_ref":"asset:sha256:source-17","target_sample_rate_hz":48000,"target_channel_count":1,"target_encoding":"pcm_f32le","idempotency_key":"transform-source-17-f32","result_class":"planned"},"happy":true,"persona_ref":"audio-operator"},
    {"scenario":"As an audio operator, I want an unsupported target rate rejected before a codec host is invoked, so that resource requirements remain bounded.","input_example":{"source_artifact_ref":"asset:sha256:source-17","source_media_type":"audio/flac","target_sample_rate_hz":4000,"target_channel_count":1,"target_encoding":"pcm_s16le","idempotency_key":"transform-source-17"},"output_example":{"operation":"","source_artifact_ref":"asset:sha256:source-17","target_sample_rate_hz":0,"target_channel_count":0,"target_encoding":"","idempotency_key":"","result_class":"unsupported_sample_rate"},"happy":false,"persona_ref":"audio-operator"},
    {"scenario":"As an audio operator, I want an unsupported channel count rejected, so that a host receives only bounded target geometry.","input_example":{"source_artifact_ref":"asset:x","source_media_type":"audio/wav","target_sample_rate_hz":48000,"target_channel_count":3,"target_encoding":"pcm_s16le","idempotency_key":"x"},"output_example":{"operation":"","source_artifact_ref":"asset:x","target_sample_rate_hz":0,"target_channel_count":0,"target_encoding":"","idempotency_key":"","result_class":"unsupported_channel_count"},"happy":false,"persona_ref":"audio-operator"},
    {"scenario":"As an audio operator, I want an unsupported target encoding rejected, so that the codec contract stays explicit.","input_example":{"source_artifact_ref":"asset:x","source_media_type":"audio/wav","target_sample_rate_hz":48000,"target_channel_count":1,"target_encoding":"mp3","idempotency_key":"x"},"output_example":{"operation":"","source_artifact_ref":"asset:x","target_sample_rate_hz":0,"target_channel_count":0,"target_encoding":"","idempotency_key":"","result_class":"unsupported_encoding"},"happy":false,"persona_ref":"audio-operator"},
    {"scenario":"As an audio operator, I want missing opaque identifiers rejected, so that no host operation is invented from ambient state.","input_example":{"source_artifact_ref":"","source_media_type":"audio/wav","target_sample_rate_hz":48000,"target_channel_count":1,"target_encoding":"pcm_s16le","idempotency_key":"x"},"output_example":{"operation":"","source_artifact_ref":"","target_sample_rate_hz":0,"target_channel_count":0,"target_encoding":"","idempotency_key":"","result_class":"invalid_request"},"happy":false,"persona_ref":"audio-operator"}
  ],
  "inputs":{"schema":{"type":"object","required":["source_artifact_ref","source_media_type","target_sample_rate_hz","target_channel_count","target_encoding","idempotency_key"],"properties":{"source_artifact_ref":{"type":"string","minLength":1},"source_media_type":{"type":"string","minLength":1},"target_sample_rate_hz":{"type":"integer","minimum":8000,"maximum":192000},"target_channel_count":{"type":"integer","minimum":1,"maximum":2},"target_encoding":{"type":"string","enum":["pcm_s16le","pcm_s24le","pcm_f32le"]},"idempotency_key":{"type":"string","minLength":1}},"additionalProperties":false}},
  "outputs":{"schema":{"type":"object","required":["operation","source_artifact_ref","target_sample_rate_hz","target_channel_count","target_encoding","idempotency_key","result_class"],"properties":{"operation":{"type":"string"},"source_artifact_ref":{"type":"string"},"target_sample_rate_hz":{"type":"integer","minimum":0},"target_channel_count":{"type":"integer","minimum":0},"target_encoding":{"type":"string"},"idempotency_key":{"type":"string"},"result_class":{"type":"string","enum":["planned","unsupported_sample_rate","unsupported_channel_count","unsupported_encoding","invalid_request"]}},"additionalProperties":false}},
