{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "core.create-audio-window-plan",
  "namespace": "core",
  "name": "create-audio-window-plan",
  "version": "1.0.0",
  "lifecycle": "active",
  "owner": { "team": "traverse-core", "contact": "maintainers@traverse-framework.org" },
  "summary": "Create a deterministic bounded-window plan for a declared-duration audio artifact.",
  "description": "Calculates overlapping window geometry from an opaque artifact reference, declared duration, and versioned policy. It does not read artifact bytes, select a codec or model, invoke a connector, access a host, or know an application workflow or content domain.",
  "use_cases": [
    { "scenario": "As an audio operator, I want a declared duration split into deterministic overlapping windows, so that a downstream worker receives bounded work units.", "input_example": { "artifact_ref": "asset:sha256:pcm-17", "duration_millis": 60000, "window_policy": { "policy_version": "1.0.0", "window_millis": 5000, "hop_millis": 2500 } }, "output_example": { "artifact_ref": "asset:sha256:pcm-17", "window_millis": 5000, "hop_millis": 2500, "window_count": 23, "policy_version": "1.0.0", "result_class": "planned" }, "happy": true, "persona_ref": "audio-operator" },
    { "scenario": "As an audio operator, I want a short artifact to produce one window, so that every positive declared duration has a bounded plan.", "input_example": { "artifact_ref": "asset:sha256:short", "duration_millis": 5000, "window_policy": { "policy_version": "1.0.0", "window_millis": 5000, "hop_millis": 2500 } }, "output_example": { "artifact_ref": "asset:sha256:short", "window_millis": 5000, "hop_millis": 2500, "window_count": 1, "policy_version": "1.0.0", "result_class": "planned" }, "happy": true, "persona_ref": "audio-operator" },
    { "scenario": "As an audio operator, I want a hop longer than its window rejected, so that no invalid overlap geometry is sent downstream.", "input_example": { "artifact_ref": "asset:sha256:pcm-17", "duration_millis": 60000, "window_policy": { "policy_version": "1.0.0", "window_millis": 5000, "hop_millis": 6000 } }, "output_example": { "artifact_ref": "asset:sha256:pcm-17", "window_millis": 0, "hop_millis": 0, "window_count": 0, "policy_version": "1.0.0", "result_class": "invalid_window_policy" }, "happy": false, "persona_ref": "audio-operator" },
    { "scenario": "As an audio operator, I want zero or missing geometry rejected, so that malformed policies do not create a plan.", "input_example": { "artifact_ref": "asset:sha256:pcm-17", "duration_millis": 60000, "window_policy": { "policy_version": "1.0.0", "window_millis": 5000, "hop_millis": 0 } }, "output_example": { "artifact_ref": "asset:sha256:pcm-17", "window_millis": 0, "hop_millis": 0, "window_count": 0, "policy_version": "1.0.0", "result_class": "invalid_window_policy" }, "happy": false, "persona_ref": "audio-operator" },
    { "scenario": "As an audio operator, I want a missing duration rejected with a stable response, so that hosts do not infer a duration from artifact bytes.", "input_example": { "artifact_ref": "asset:sha256:pcm-17", "window_policy": { "policy_version": "1.0.0", "window_millis": 5000, "hop_millis": 2500 } }, "output_example": { "artifact_ref": "asset:sha256:pcm-17", "window_millis": 0, "hop_millis": 0, "window_count": 0, "policy_version": "1.0.0", "result_class": "invalid_request" }, "happy": false, "persona_ref": "audio-operator" },
    { "scenario": "As an audio operator, I want a fractional duration rejected, so that window counts remain integer and reproducible.", "input_example": { "artifact_ref": "asset:sha256:pcm-17", "duration_millis": 60000.5, "window_policy": { "policy_version": "1.0.0", "window_millis": 5000, "hop_millis": 2500 } }, "output_example": { "artifact_ref": "asset:sha256:pcm-17", "window_millis": 0, "hop_millis": 0, "window_count": 0, "policy_version": "1.0.0", "result_class": "invalid_request" }, "happy": false, "persona_ref": "audio-operator" }
  ],
  "inputs": { "schema": { "type": "object", "required": ["artifact_ref", "duration_millis", "window_policy"], "properties": { "artifact_ref": { "type": "string", "minLength": 1 }, "duration_millis": { "type": "integer", "minimum": 1 }, "window_policy": { "type": "object", "required": ["policy_version", "window_millis", "hop_millis"], "properties": { "policy_version": { "type": "string", "minLength": 1 }, "window_millis": { "type": "integer", "minimum": 1, "maximum": 60000 }, "hop_millis": { "type": "integer", "minimum": 1, "maximum": 60000 } }, "additionalProperties": false } }, "additionalProperties": false } },
  "outputs": { "schema": { "type": "object", "required": ["artifact_ref", "window_millis", "hop_millis", "window_count", "policy_version", "result_class"], "properties": { "artifact_ref": { "type": "string" }, "window_millis": { "type": "integer", "minimum": 0 }, "hop_millis": { "type": "integer", "minimum": 0 }, "window_count": { "type": "integer", "minimum": 0 }, "policy_version": { "type": "string" }, "result_class": { "type": "string", "enum": ["planned", "invalid_window_policy", "invalid_request"] } }, "additionalProperties": false } },
  "preconditions": [{ "id": "declared-duration", "description": "The caller supplies a positive integer duration without reading or deriving it from bytes." }],
  "postconditions": [{ "id": "deterministic-plan", "description": "Identical input produces identical window geometry." }, { "id": "no-artifact-read", "description": "Planning never accesses the referenced artifact." }],
  "side_effects": [{ "kind": "memory_only", "description": "Pure plan calculation with no persistence, connector, file, network, or device action." }],
  "emits": [], "consumes": [], "permissions": [{ "id": "core.create-audio-window-plan.execute" }],
  "execution": { "binary_format": "wasm", "entrypoint": { "kind": "wasi-command", "command": "run" }, "preferred_targets": ["local", "edge", "device"], "constraints": { "host_api_access": "none", "network_access": "forbidden", "filesystem_access": "none" } },
  "policies": [{ "id": "bounded-window-policy" }], "dependencies": [],
  "provenance": { "source": "greenfield", "author": "traverse-core", "created_at": "2026-09-06T00:00:00Z", "spec_ref": "100-capability-package-authoring@1.0.0", "adr_refs": ["ADR-0039"], "exception_refs": [] },
  "evidence": [], "state_schema": null, "service_type": "stateless", "permitted_targets": ["local", "edge", "device"], "artifact_type": "native",
  "artifact": { "digest": "sha256:ecc7aba24eee918106999ab89cbcacda212502aae32f8692d35b00565a95dca4", "url": "https://github.com/traverse-framework/registry/releases/download/artifacts/core.create-audio-window-plan-1.0.0/core-create-audio-window-plan.wasm" }
}
