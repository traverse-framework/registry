            "recipient_id": "user-carol",
            "subject": "Action blocked: Send the revised proposal"
          }
        ],
        "reason_code": "ok"
      },
      "persona_ref": "meeting-organizer",
      "scenario": "As WF4, I want blocked notification intents for stakeholders."
