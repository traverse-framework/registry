  "state_schema": null,
  "summary": "Prepares notification intents for stakeholders when an action item changes status. Pure — does not send.",
  "use_cases": [
    {
      "happy": true,
      "input_example": {
        "event_type": "completed",
        "item": {
          "id": "ai-1",
          "owner_id": "user-ada",
          "owner_name": "Ada",
          "status": "done",
          "title": "Send the revised proposal"
        },
        "notify_config": {
          "include_manager_on_complete": true,
          "version": "1.0"
        },
        "stakeholders": [
          {
            "channel": "in_app",
            "role": "requester",
            "user_id": "user-carol"
          },
          {
            "channel": "email",
            "role": "manager",
            "user_id": "user-mgr"
          }
        ]
      },
      "output_example": {
        "evaluation_trace": [
          "event_type=completed",
          "prepared 2 intents"
        ],
        "intent_count": 2,
        "intents": [
          {
            "body": "Ada marked \"Send the revised proposal\" as done.",
            "channel": "in_app",
            "recipient_id": "user-carol",
            "subject": "Action completed: Send the revised proposal"
          },
          {
            "body": "Ada marked \"Send the revised proposal\" as done.",
            "channel": "email",
            "recipient_id": "user-mgr",
            "subject": "Action completed: Send the revised proposal"
          }
        ],
        "reason_code": "ok"
      },
      "persona_ref": "meeting-organizer",
      "scenario": "As the completion path, I want requester and manager notified that an item is done."
    },
    {
      "happy": false,
      "input_example": {
        "event_type": "completed",
        "item": {
          "id": "ai-3",
          "owner_id": "user-bob",
          "owner_name": "Bob",
          "status": "done",
          "title": "Draft agenda"
        },
        "notify_config": {
          "include_manager_on_complete": true,
          "version": "1.0"
        },
        "stakeholders": []
      },
      "output_example": {
        "evaluation_trace": [
          "event_type=completed",
          "prepared 0 intents"
        ],
        "intent_count": 0,
        "intents": [],
        "reason_code": "nothing_to_notify"
      },
      "persona_ref": "runtime-engineer",
      "scenario": "As the system, I want zero intents when there are no stakeholders."
    },
    {
      "happy": true,
      "input_example": {
        "event_type": "status_changed",
        "item": {
          "id": "ai-1",
          "owner_id": "user-ada",
          "owner_name": "Ada",
          "status": "in_progress",
          "title": "Send the revised proposal"
        },
        "notify_config": {
          "include_manager_on_complete": true,
          "version": "1.0"
        },
        "stakeholders": [
          {
            "channel": "in_app",
            "role": "requester",
            "user_id": "user-carol"
          }
        ]
      },
      "output_example": {
        "evaluation_trace": [
          "event_type=status_changed",
          "prepared 1 intents"
        ],
        "intent_count": 1,
        "intents": [
          {
            "body": "Ada updated \"Send the revised proposal\".",
            "channel": "in_app",
            "recipient_id": "user-carol",
            "subject": "Action updated: Send the revised proposal"
          }
        ],
        "reason_code": "ok"
      },
      "persona_ref": "collaboration-product-owner",
      "scenario": "As WF4, I want status_changed notification intents for stakeholders."
    },
    {
      "happy": true,
      "input_example": {
        "event_type": "blocked",
        "item": {
