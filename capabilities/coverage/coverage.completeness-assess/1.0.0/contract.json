    "schema": {
      "additionalProperties": false,
      "properties": {
        "coverage_millis": {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "coverage_state": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ],
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "coverage_complete",
            "coverage_partial",
            "source_unhealthy",
            "invalid_scope"
          ],
          "type": "string"
        }
      },
      "required": [
        "coverage_state",
        "coverage_millis",
        "reason_code",
        "policy_version"
      ],
      "type": "object"
    }
  },
  "owner": {
    "contact": "maintainers@callweave.local",
    "team": "callweave"
  },
