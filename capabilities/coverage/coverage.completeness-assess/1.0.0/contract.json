  "connector_requirements": [],
  "consumes": [],
  "dependencies": [],
  "description": "Pure standalone coverage calculation. It distinguishes complete, partial, and unavailable coverage from supplied duration and source-health facts. It does not capture inputs, inspect a device, query storage, schedule work, or know any application workflow.",
  "emits": [],
  "event_trigger": null,
  "evidence": [],
  "execution": {
    "binary_format": "wasm",
    "constraints": {
      "filesystem_access": "none",
      "host_api_access": "none",
      "network_access": "forbidden"
    },
    "entrypoint": {
      "command": "run",
      "kind": "wasi-command"
    },
    "preferred_targets": [
      "local",
      "browser",
      "edge",
      "device"
    ]
  },
  "id": "coverage.completeness-assess",
  "inputs": {
    "schema": {
      "additionalProperties": false,
      "properties": {
        "coverage_facts": {
          "additionalProperties": false,
          "properties": {
            "captured_minutes": {
              "minimum": 0,
              "type": "integer"
            },
            "expected_minutes": {
              "minimum": 0,
              "type": "integer"
            },
            "processed_minutes": {
              "minimum": 0,
              "type": "integer"
            },
            "source_health": {
              "enum": [
                "healthy",
                "unhealthy"
              ],
              "type": "string"
            },
            "valid_minutes": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "expected_minutes",
            "captured_minutes",
            "valid_minutes",
            "processed_minutes",
            "source_health"
          ],
          "type": "object"
        },
        "coverage_policy": {
          "additionalProperties": false,
          "properties": {
            "complete_threshold_millis": {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "version",
            "complete_threshold_millis"
          ],
          "type": "object"
        }
      },
      "required": [
        "coverage_facts",
        "coverage_policy"
      ],
      "type": "object"
    }
  },
  "kind": "capability_contract",
  "lifecycle": "active",
  "name": "completeness-assess",
  "namespace": "coverage",
