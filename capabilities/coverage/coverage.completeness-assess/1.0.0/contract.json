    {
      "description": "Pure calculation; no host, network, filesystem, model, or state access.",
      "kind": "memory_only"
    }
  ],
  "state_schema": null,
  "summary": "Assess the completeness of supplied coverage facts.",
  "use_cases": [
    {
      "happy": true,
      "input_example": {
        "coverage_facts": {
          "captured_minutes": 1440,
          "expected_minutes": 1440,
          "processed_minutes": 1435,
          "source_health": "healthy",
          "valid_minutes": 1435
        },
        "coverage_policy": {
          "complete_threshold_millis": 950,
          "version": "1.0.0"
        }
      },
      "output_example": {
        "coverage_millis": 996,
        "coverage_state": "complete",
        "policy_version": "1.0.0",
        "reason_code": "coverage_complete"
      },
      "persona_ref": "coverage-consumer",
      "scenario": "As a coverage consumer, I want fully captured and processed healthy coverage marked complete so that I can trust the completeness boundary."
    },
    {
      "happy": true,
      "input_example": {
        "coverage_facts": {
          "captured_minutes": 900,
          "expected_minutes": 1440,
          "processed_minutes": 850,
          "source_health": "healthy",
          "valid_minutes": 850
        },
        "coverage_policy": {
          "complete_threshold_millis": 950,
          "version": "1.0.0"
        }
      },
      "output_example": {
        "coverage_millis": 590,
        "coverage_state": "partial",
        "policy_version": "1.0.0",
        "reason_code": "coverage_partial"
      },
      "persona_ref": "coverage-consumer",
      "scenario": "As a coverage consumer, I want incomplete but healthy coverage marked partial so that reduced completeness is not confused with full availability."
    },
    {
      "happy": false,
      "input_example": {
        "coverage_facts": {
          "captured_minutes": 0,
          "expected_minutes": 1440,
          "processed_minutes": 0,
          "source_health": "unhealthy",
          "valid_minutes": 0
        },
        "coverage_policy": {
          "complete_threshold_millis": 950,
          "version": "1.0.0"
        }
      },
      "output_example": {
        "coverage_millis": 0,
        "coverage_state": "unavailable",
        "policy_version": "1.0.0",
        "reason_code": "source_unhealthy"
      },
      "persona_ref": "coverage-consumer",
      "scenario": "As a coverage consumer, I want an unhealthy source marked unavailable so that source failure is not interpreted as complete coverage."
    },
    {
      "happy": false,
      "input_example": {
        "coverage_facts": {
          "captured_minutes": 0,
          "expected_minutes": 0,
          "processed_minutes": 0,
          "source_health": "healthy",
          "valid_minutes": 0
        },
        "coverage_policy": {
          "complete_threshold_millis": 950,
          "version": "1.0.0"
        }
      },
      "output_example": {
        "coverage_millis": 0,
        "coverage_state": "unavailable",
        "policy_version": "1.0.0",
        "reason_code": "invalid_scope"
      },
      "persona_ref": "coverage-consumer",
      "scenario": "As a coverage consumer, I want an invalid expected duration marked unavailable so that completeness is never invented from an empty scope."
    }
  ],
  "version": "1.0.0"
