    "device"
  ],
  "policies": [
    {
      "id": "deterministic-policy-only"
    },
    {
      "id": "absence-not-inferred"
    }
  ],
  "postconditions": [
    {
      "description": "Identical facts and policy inputs yield identical output.",
      "id": "deterministic"
    },
    {
      "description": "An unavailable or partial result does not make a stronger claim than the supplied coverage facts support.",
      "id": "absence-not-inferred"
    }
  ],
  "preconditions": [
    {
      "description": "A non-empty policy version and bounded completion threshold are supplied.",
      "id": "policy-is-versioned"
    }
  ],
