{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "inference.ensemble-reconcile",
  "namespace": "inference",
  "name": "ensemble-reconcile",
  "version": "1.0.0",
  "lifecycle": "experimental",
  "owner": {
    "team": "callweave",
    "contact": "https://github.com/enricopiovesan"
  },
  "authoring": {
    "method": "llm-assisted",
    "source_revision": "673aa3a",
    "test_evidence": "Callweave WASM smoke: agreement, disagreement, bounds",
    "review": {
      "decision": "pending-qualified-review",
      "pr": "pending",
      "reviewer": "traverse-registry-maintainer"
    }
  },
  "summary": "Reconcile two bounded analyzer scores using an explicit agreement policy.",
  "description": "Taxonomy-neutral deterministic reconciliation. It preserves both source scores, computes their mean only when disagreement is within policy, and otherwise returns unknown. It does not call models or access hosts.",
  "use_cases": [
    {
      "scenario": "As an evidence consumer, I want agreeing analyzer scores reconciled into one bounded confidence so that downstream policy can make a deterministic decision.",
      "input_example": {
        "evidence_id": "e1",
        "score_a_millis": 800,
        "score_b_millis": 760,
        "policy": {
          "version": "ens-1",
          "max_disagreement_millis": 100
        }
      },
      "output_example": {
        "evidence_id": "e1",
        "reconciled_score_millis": 780,
        "result_class": "consensus"
      },
      "happy": true,
      "persona_ref": "audio-processing-consumer"
    },
    {
      "scenario": "As an evidence consumer, I want materially disagreeing analyzer scores marked unknown so that weak ensemble agreement is never promoted.",
      "input_example": {
        "evidence_id": "e2",
        "score_a_millis": 900,
        "score_b_millis": 200,
        "policy": {
          "version": "ens-1",
          "max_disagreement_millis": 100
        }
      },
      "output_example": {
        "evidence_id": "e2",
        "result_class": "disagreement"
      },
      "happy": false,
      "persona_ref": "audio-processing-consumer"
    }
  ],
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "evidence_id",
        "score_a_millis",
        "score_b_millis",
        "policy"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "score_a_millis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "score_b_millis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "policy": {
          "type": "object",
          "required": [
            "version",
            "max_disagreement_millis"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "max_disagreement_millis": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": [
        "evidence_id",
        "score_a_millis",
        "score_b_millis",
        "reconciled_score_millis",
        "policy_version",
        "result_class"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "score_a_millis": {
          "type": "integer"
        },
        "score_b_millis": {
          "type": "integer"
        },
        "reconciled_score_millis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "policy_version": {
          "type": "string"
        },
        "result_class": {
          "type": "string",
          "enum": [
            "consensus",
            "disagreement",
            "invalid_request"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "preconditions": [
    {
      "id": "bounded-scores",
      "description": "Both analyzer scores are integer values in 0..1000."
    }
  ],
  "postconditions": [
    {
      "id": "agreement-gated",
      "description": "Only scores within the configured disagreement limit produce consensus."
    },
    {
      "id": "deterministic",
      "description": "Identical input and policy produce identical output."
    }
  ],
  "side_effects": [
    {
      "kind": "memory_only",
      "description": "Pure calculation."
    }
  ],
