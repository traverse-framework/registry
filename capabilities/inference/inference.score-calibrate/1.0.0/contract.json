{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "inference.score-calibrate",
  "namespace": "inference",
  "name": "score-calibrate",
  "version": "1.0.0",
  "lifecycle": "experimental",
  "owner": {
    "team": "callweave",
    "contact": "https://github.com/enricopiovesan"
  },
  "authoring": {
    "method": "llm-assisted",
    "source_revision": "5f48de4",
