  "use_cases": [
    {
      "happy": true,
      "persona_ref": "platform-developer",
      "scenario": "As a platform developer, I want to put durable pricing rates for a currency, so that checkout hosts apply consistent multipliers across sessions.",
      "input_example": {
        "action": "put",
        "config": {
          "config_id": "pc-1",
          "currency": "USD",
          "rates": {
            "base": 1.0,
            "vip": 0.9
          }
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "config": {
          "config_id": "pc-1",
          "currency": "USD",
          "rates": {
            "base": 1.0,
            "vip": 0.9
          }
        },
