        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "deleted config"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want get to report not_found when no pricing config exists, so that the host can fall back to default rates explicitly.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": false,
