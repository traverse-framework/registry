  "summary": "Durable pricing configuration retained via host managed state.",
  "description": "Stateful put/get/delete for a single fixed-schema pricing config (config_id, currency, rates as string->number object). Resource identity lives inside the value; the relative host key is always config. Uses traverse_host state_put/state_get/state_delete. Browser targets are excluded. Supersedes 1.0.0 which string-encoded rates_json.",
  "emits": [],
  "side_effects": [
    {
      "description": "Validates action envelope and config fields in memory",
      "kind": "memory_only"
    },
    {
      "description": "Reads or mutates host-managed DataStore pricing config via traverse_host state_*",
      "kind": "memory_only"
    }
  ],
