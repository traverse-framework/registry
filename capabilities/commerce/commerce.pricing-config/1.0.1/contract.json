        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "config": {
          "config_id": "pc-1",
          "currency": "USD",
          "rates": {
            "base": 1.0,
            "vip": 0.9
