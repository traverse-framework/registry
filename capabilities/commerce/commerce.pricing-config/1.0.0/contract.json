  "use_cases": [
    {
      "happy": true,
      "persona_ref": "platform-developer",
      "scenario": "As a platform developer, I want to put a config record, so that durable state is available on later gets.",
      "input_example": {
        "action": "put",
        "config": {
          "config_id": "price-1",
          "currency": "USD",
          "rates_json": "base=1.0"
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "config": {
          "config_id": "price-1",
          "currency": "USD",
          "rates_json": "base=1.0"
        },
        "evaluation_trace": [
          "config put"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "platform-developer",
      "scenario": "As a platform developer, I want to get a stored config, so that I can resume from host state.",
