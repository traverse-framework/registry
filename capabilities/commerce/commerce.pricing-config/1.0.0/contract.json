        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "config": {
          "config_id": "price-1",
          "currency": "USD",
          "rates_json": "base=1.0"
        },
        "evaluation_trace": [
          "config found"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "platform-developer",
      "scenario": "As a platform developer, I want to delete a config, so that stale durable state is cleared.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "config deleted"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "platform-developer",
      "scenario": "As a platform developer, I want missing config fields rejected, so that corrupt puts fail closed.",
      "input_example": {
        "action": "put",
        "config": {
          "config_id": "price-1",
          "currency": "",
          "rates_json": ""
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "platform-developer",
      "scenario": "As a platform developer, I want unknown actions rejected, so that the contract surface stays closed.",
