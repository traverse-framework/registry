  },
  "inputs": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cart_id",
        "line_id",
        "sku",
        "qty_before",
        "qty_after",
        "actor_id"
      ],
      "properties": {
        "cart_id": {
          "type": "string"
        },
        "line_id": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        },
        "qty_before": {
          "type": "integer"
        },
        "qty_after": {
          "type": "integer"
        },
