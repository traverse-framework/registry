          "type": "string"
        }
      }
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "qty_before",
        "qty_after",
        "reason_code"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "qty_before": {
          "type": "integer"
        },
        "qty_after": {
          "type": "integer"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "ok",
            "invalid_qty",
            "no_change",
            "invalid_input"
          ]
        },
        "evaluation_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "use_cases": [
    {
      "happy": true,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want a quantity increase accepted and emitted, so that inventory and UI subscribers stay in sync.",
      "input_example": {
        "cart_id": "cart-1",
        "line_id": "line-1",
        "sku": "SKU-A",
        "qty_before": 1,
        "qty_after": 3,
        "actor_id": "user-ada"
      },
      "output_example": {
        "accepted": true,
        "qty_before": 1,
        "qty_after": 3,
        "reason_code": "ok",
        "evaluation_trace": [
          "line-1 qty changed"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want qty_after=0 accepted, so that removing a line is a real line-changed fact.",
      "input_example": {
        "cart_id": "cart-1",
        "line_id": "line-1",
        "sku": "SKU-A",
        "qty_before": 2,
        "qty_after": 0,
        "actor_id": "user-ada"
      },
      "output_example": {
        "accepted": true,
        "qty_before": 2,
        "qty_after": 0,
        "reason_code": "ok",
        "evaluation_trace": [
          "line-1 qty changed"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want negative quantities rejected, so that corrupt cart updates fail closed.",
      "input_example": {
        "cart_id": "cart-1",
        "line_id": "line-1",
        "sku": "SKU-A",
        "qty_before": 1,
        "qty_after": -1,
        "actor_id": "user-ada"
      },
      "output_example": {
        "accepted": false,
        "qty_before": 1,
        "qty_after": -1,
        "reason_code": "invalid_qty",
        "evaluation_trace": [
          "qty_before and qty_after must be >= 0"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want identical before/after quantities rejected, so that no-op updates do not spam subscribers.",
      "input_example": {
        "cart_id": "cart-1",
        "line_id": "line-1",
        "sku": "SKU-A",
        "qty_before": 2,
        "qty_after": 2,
        "actor_id": "user-ada"
      },
      "output_example": {
        "accepted": false,
        "qty_before": 2,
        "qty_after": 2,
        "reason_code": "no_change",
        "evaluation_trace": [
          "qty_before equals qty_after; nothing to emit"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want incomplete payloads rejected with invalid_input, so that partial updates cannot emit events.",
      "input_example": {
        "cart_id": "cart-1"
      },
      "output_example": {
        "accepted": false,
        "qty_before": 0,
        "qty_after": 0,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed: required string fields missing"
        ]
      }
    }
  ]
}
