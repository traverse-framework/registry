  "summary": "Validate a cart line quantity change and emit a governed cart.line-changed event.",
  "description": "Given cart_id, line_id, sku, qty_before, qty_after, and actor_id, validates that identity fields are present and both quantities are integers >= 0, and that the quantities actually differ. On success (reason_code=ok) the WASM guest calls traverse_host::emit_event for commerce.cart.line-changed@1.0.0 with the full line-change payload. Does not persist cart state.",
  "event_trigger": "commerce.cart-line-changed.triggered",
  "emits": [
    {
      "event_id": "commerce.cart.line-changed",
      "version": "1.0.0"
    }
  ],
  "side_effects": [
    {
      "description": "Pure validation of cart line quantity change",
      "kind": "memory_only"
    },
    {
      "description": "Emits commerce.cart.line-changed@1.0.0 via traverse_host::emit_event when accepted (ok)",
      "kind": "event_emission"
    }
  ],
  "preconditions": [
    {
      "id": "fields-present",
      "description": "Required string fields and integer quantities are present"
    },
    {
      "id": "qty-non-negative",
      "description": "qty_before and qty_after must be >= 0"
    }
  ],
  "provenance": {
    "source": "greenfield",
    "author": "traverse/registry",
