      "happy": true,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want pending \u2192 confirmed accepted, so that payment success advances the order.",
      "input_example": {
        "order_id": "ord-1",
        "current_status": "pending",
        "requested_status": "confirmed",
        "actor_id": "ops-1",
        "transition_config": {
          "version": "1.0",
          "allowed_transitions": {
            "pending": [
              "confirmed",
              "cancelled"
            ],
            "confirmed": [
              "fulfilled",
              "cancelled"
            ],
            "fulfilled": [
              "shipped",
              "cancelled"
            ],
            "shipped": [
              "delivered",
              "returned"
            ],
            "delivered": [],
            "cancelled": [],
            "returned": []
          }
        }
      },
      "output_example": {
        "allowed": true,
        "new_status": "confirmed",
        "reason_code": "ok",
        "evaluation_trace": [
          "pending \u2192 confirmed is allowed"
        ]
      }
