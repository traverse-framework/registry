  "summary": "Deterministic order status transition under a caller-supplied allowed graph.",
  "description": "Evaluates current_status \u2192 requested_status against transition_config.allowed_transitions for known commerce order statuses (pending, confirmed, fulfilled, shipped, delivered, cancelled, returned). On accepted transitions (reason_code=ok) emits commerce.order.status-changed@1.0.0 via traverse_host::emit_event. Does not persist orders.",
  "event_trigger": "commerce.order-status-changed.triggered",
  "emits": [
    {
      "event_id": "commerce.order.status-changed",
      "version": "1.0.0"
    }
  ],
  "side_effects": [
    {
      "description": "Pure order status transition evaluation",
      "kind": "memory_only"
    },
    {
      "description": "Emits commerce.order.status-changed@1.0.0 via traverse_host::emit_event when accepted (ok)",
      "kind": "event_emission"
    }
  ],
  "preconditions": [
    {
      "id": "statuses-valid",
      "description": "current and requested status must be known order statuses"
    }
  ],
