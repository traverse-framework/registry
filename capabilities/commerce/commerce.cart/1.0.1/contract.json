  "use_cases": [
    {
      "happy": true,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want to put a durable cart with line items, so that the shopper's selections survive across checkout steps.",
      "input_example": {
        "action": "put",
        "cart": {
          "cart_id": "c-1",
          "currency": "USD",
          "lines": [
            {
              "sku": "sku-1",
              "qty": 1
            },
            {
              "sku": "sku-2",
              "qty": 2
            }
          ]
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "cart": {
          "cart_id": "c-1",
          "currency": "USD",
          "lines": [
            {
              "sku": "sku-1",
              "qty": 1
            },
            {
              "sku": "sku-2",
              "qty": 2
            }
          ]
        },
        "evaluation_trace": [
          "put cart"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "platform-developer",
      "scenario": "As a platform developer, I want to get the durable cart, so that checkout or pricing hosts can restore the shopper basket after reconnect.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "cart": {
          "cart_id": "c-1",
          "currency": "USD",
          "lines": [
            {
              "sku": "sku-1",
              "qty": 1
            },
            {
              "sku": "sku-2",
              "qty": 2
            }
          ]
        },
        "evaluation_trace": [
          "got cart"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want to delete a cart after order placement, so that stale baskets do not linger in host state.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "deleted cart"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "platform-developer",
      "scenario": "As a platform developer, I want get to report not_found when no cart exists, so that the host can start an empty basket instead of assuming prior lines.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "not_found",
        "found": false,
        "evaluation_trace": [
          "cart absent"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want put without a cart object rejected as invalid_input, so that incomplete writes cannot corrupt host state.",
      "input_example": {
        "action": "put"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed: cart object required for put"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "platform-developer",
      "scenario": "As a platform developer, I want an unknown action rejected as invalid_action, so that unsupported verbs fail closed before touching the store.",
      "input_example": {
        "action": "list"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_action",
        "evaluation_trace": [
          "action must be get, put, or delete"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "checkout-flow-developer",
      "scenario": "As a checkout flow developer, I want host store failures surfaced as host_error, so that I can retry cart persistence instead of treating a failed put as success.",
      "input_example": {
        "action": "put",
        "cart": {
          "cart_id": "c-err",
          "currency": "USD",
          "lines": [
            {
              "sku": "sku-1",
              "qty": 1
            }
          ]
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "host_error",
        "evaluation_trace": [
          "state_put failed"
        ]
      }
    }
  ]
