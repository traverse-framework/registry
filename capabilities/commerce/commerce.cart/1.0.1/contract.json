  "summary": "Durable commerce cart retained via host managed state.",
  "description": "Stateful put/get/delete for a single fixed-schema cart record (cart_id, currency, lines[{sku,qty}]). Resource identity lives inside the value; the relative host key is always cart. Uses traverse_host state_put/state_get/state_delete. Browser targets are excluded. Distinct from commerce.cart-line-changed. Supersedes 1.0.0 which string-encoded lines_json.",
  "emits": [],
  "side_effects": [
    {
      "description": "Validates action envelope and cart fields in memory",
      "kind": "memory_only"
    },
    {
      "description": "Reads or mutates host-managed DataStore cart state via traverse_host state_*",
      "kind": "memory_only"
    }
  ],
  "preconditions": [
    {
      "id": "action-valid",
      "description": "action must be put, get, or delete; put requires a complete cart object"
