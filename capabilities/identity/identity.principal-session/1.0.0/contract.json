  "summary": "Put, get, or delete a durable authenticated principal session via host-managed state.",
  "description": "Persists principal session records through traverse_host::state_* under fixed key session. Browser excluded.",
  "emits": [],
  "side_effects": [
    {
      "description": "Validates action envelope and session fields in memory",
      "kind": "memory_only"
    },
    {
      "description": "Reads or mutates host-managed session state via traverse_host state_*",
      "kind": "memory_only"
    }
  ],
  "preconditions": [
    {
      "id": "action-valid",
      "description": "action must be put, get, or delete; put requires a complete session object"
    }
  ],
