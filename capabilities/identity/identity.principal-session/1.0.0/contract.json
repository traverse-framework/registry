  "use_cases": [
    {
      "happy": true,
      "persona_ref": "platform-security-engineer",
      "scenario": "As a platform security engineer, I want to put a durable authenticated session with scopes, so that authorization context survives across runtime invocations.",
      "input_example": {
        "action": "put",
        "session": {
          "session_id": "sess-1",
          "principal_id": "prin-1",
          "scopes": [
            "read",
            "write"
          ],
          "issued_at": "2026-09-08T20:00:00Z"
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "session": {
          "session_id": "sess-1",
          "principal_id": "prin-1",
          "scopes": [
            "read",
            "write"
          ],
          "issued_at": "2026-09-08T20:00:00Z"
        },
        "evaluation_trace": [
          "put session"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi-tenant SaaS developer, I want to get the durable principal session, so that my tenant app can restore the authenticated principal and scopes after reconnect.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "session": {
          "session_id": "sess-1",
          "principal_id": "prin-1",
          "scopes": [
            "read",
            "write"
          ],
          "issued_at": "2026-09-08T20:00:00Z"
        },
        "evaluation_trace": [
          "got session"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "signup-form-developer",
      "scenario": "As a signup form developer, I want to delete a principal session on sign-out, so that session state is not left pointing at an idle authenticated context.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "deleted session"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi-tenant SaaS developer, I want get to report not_found when no session exists, so that my client can send the user through auth instead of assuming a live session.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "not_found",
        "found": false,
        "evaluation_trace": [
          "session absent"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "platform-security-engineer",
      "scenario": "As a platform security engineer, I want put without a session object rejected as invalid_input, so that incomplete session writes cannot corrupt host state.",
      "input_example": {
        "action": "put"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed: session object required for put"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "signup-form-developer",
      "scenario": "As a signup form developer, I want an unknown action rejected as invalid_action, so that unsupported verbs fail closed before touching the store.",
      "input_example": {
        "action": "list"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_action",
        "evaluation_trace": [
          "action must be get, put, or delete"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi-tenant SaaS developer, I want host store failures surfaced as host_error, so that I can retry session persistence instead of treating a failed put as success.",
      "input_example": {
        "action": "put",
        "session": {
          "session_id": "sess-err",
          "principal_id": "prin-1",
          "scopes": [
            "read",
            "write"
          ],
          "issued_at": "2026-09-08T20:00:00Z"
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "host_error",
        "evaluation_trace": [
          "state_put failed"
        ]
      }
    }
