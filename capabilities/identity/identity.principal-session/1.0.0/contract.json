  "summary": "Durable authenticated principal session retained via host managed state.",
  "description": "Stateful put/get/delete for a single fixed-schema authenticated session record (session_id, principal_id, scopes[], issued_at as string). Resource identity lives inside the value; the relative host key is always session. Uses traverse_host state_put/state_get/state_delete. Browser targets are excluded.",
  "emits": [],
  "side_effects": [
    {
      "description": "Validates action envelope and session fields in memory",
      "kind": "memory_only"
    },
    {
      "description": "Reads or mutates host-managed session state via traverse_host state_*",
      "kind": "memory_only"
    }
  ],
