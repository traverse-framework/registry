  "use_cases": [
    {
      "happy": true,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi tenant saas developer, I want to put a session record, so that durable state is available on later gets.",
      "input_example": {
        "action": "put",
        "session": {
          "session_id": "sess-1",
          "principal_id": "user-ada",
          "scopes_json": "read,write",
          "issued_at": "2026-09-08T20:00:00Z"
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "session": {
          "session_id": "sess-1",
          "principal_id": "user-ada",
          "scopes_json": "read,write",
          "issued_at": "2026-09-08T20:00:00Z"
        },
        "evaluation_trace": [
          "session put"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi tenant saas developer, I want to get a stored session, so that I can resume from host state.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "session": {
          "session_id": "sess-1",
          "principal_id": "user-ada",
          "scopes_json": "read,write",
          "issued_at": "2026-09-08T20:00:00Z"
        },
        "evaluation_trace": [
          "session found"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi tenant saas developer, I want to delete a session, so that stale durable state is cleared.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "session deleted"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi tenant saas developer, I want missing session fields rejected, so that corrupt puts fail closed.",
      "input_example": {
        "action": "put",
        "session": {
          "session_id": "sess-1",
          "principal_id": "",
          "scopes_json": "",
          "issued_at": ""
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi tenant saas developer, I want unknown actions rejected, so that the contract surface stays closed.",
      "input_example": {
        "action": "list"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_action",
        "evaluation_trace": [
          "action must be get, put, or delete"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi tenant saas developer, I want a missing session get to return not_found, so that callers can branch honestly.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "not_found",
        "found": false,
        "evaluation_trace": [
          "session missing"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi tenant saas developer, I want host store failures surfaced as host_error, so that misconfiguration is never silent.",
      "input_example": {
        "action": "put",
        "session": {
          "session_id": "sess-1",
          "principal_id": "user-ada",
          "scopes_json": "read,write",
          "issued_at": "2026-09-08T20:00:00Z"
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "host_error",
        "evaluation_trace": [
          "state_put failed"
        ]
      }
