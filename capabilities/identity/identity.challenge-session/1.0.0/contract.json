  "summary": "Durable auth challenge retained via host managed state.",
  "description": "Stateful put/get/delete for a single fixed-schema auth challenge record (challenge_id, principal_hint, method, expires_at, status as string). Resource identity lives inside the value; the relative host key is always challenge. Uses traverse_host state_put/state_get/state_delete. Browser targets are excluded.",
  "emits": [],
  "side_effects": [
    {
      "description": "Validates action envelope and challenge fields in memory",
      "kind": "memory_only"
    },
    {
      "description": "Reads or mutates host-managed challenge state via traverse_host state_*",
      "kind": "memory_only"
    }
  ],
