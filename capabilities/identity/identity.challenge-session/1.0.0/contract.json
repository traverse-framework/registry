  "use_cases": [
    {
      "happy": true,
      "persona_ref": "platform-security-engineer",
      "scenario": "As a platform security engineer, I want to put a durable auth challenge bound to a principal hint and method, so that MFA/OTP challenge state survives across runtime invocations.",
      "input_example": {
        "action": "put",
        "challenge": {
          "challenge_id": "ch-1",
          "principal_hint": "user@example.com",
          "method": "email_otp",
          "expires_at": "2026-09-08T21:00:00Z",
          "status": "pending"
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "challenge": {
          "challenge_id": "ch-1",
          "principal_hint": "user@example.com",
          "method": "email_otp",
          "expires_at": "2026-09-08T21:00:00Z",
          "status": "pending"
        },
        "evaluation_trace": [
          "put challenge"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "signup-form-developer",
      "scenario": "As a signup form developer, I want to get the durable auth challenge, so that my client can resume an in-flight verification after reconnect.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "challenge": {
          "challenge_id": "ch-1",
          "principal_hint": "user@example.com",
          "method": "email_otp",
          "expires_at": "2026-09-08T21:00:00Z",
          "status": "pending"
        },
        "evaluation_trace": [
          "got challenge"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi-tenant SaaS developer, I want to delete a challenge after it is consumed or expired, so that stale challenges cannot be reused across tenants.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "deleted challenge"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "signup-form-developer",
      "scenario": "As a signup form developer, I want get to report not_found when no challenge exists, so that my client can start a fresh challenge instead of assuming one is live.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "not_found",
        "found": false,
        "evaluation_trace": [
          "challenge absent"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "platform-security-engineer",
      "scenario": "As a platform security engineer, I want put without a challenge object rejected as invalid_input, so that incomplete challenge writes cannot corrupt host state.",
      "input_example": {
        "action": "put"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed: challenge object required for put"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "multi-tenant-saas-developer",
      "scenario": "As a multi-tenant SaaS developer, I want an unknown action rejected as invalid_action, so that unsupported verbs fail closed before touching the store.",
      "input_example": {
        "action": "list"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_action",
        "evaluation_trace": [
          "action must be get, put, or delete"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "signup-form-developer",
      "scenario": "As a signup form developer, I want host store failures surfaced as host_error, so that I can retry challenge persistence instead of treating a failed put as success.",
      "input_example": {
        "action": "put",
        "challenge": {
          "challenge_id": "ch-err",
          "principal_hint": "user@example.com",
          "method": "email_otp",
          "expires_at": "2026-09-08T21:00:00Z",
          "status": "pending"
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "host_error",
        "evaluation_trace": [
          "state_put failed"
        ]
      }
    }
  ]
