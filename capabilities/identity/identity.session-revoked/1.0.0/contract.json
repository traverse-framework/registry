  "id": "identity.session-revoked",
  "namespace": "identity",
  "name": "session-revoked",
  "version": "1.0.0",
  "authoring": {
    "method": "llm-assisted",
    "source_revision": "feat/service-type-fill-wave1",
    "test_evidence": "capability-src/identity-session-revoked cargo test (6 passing)",
