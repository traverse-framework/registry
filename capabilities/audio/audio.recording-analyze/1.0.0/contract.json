  "version": "1.0.0",
  "lifecycle": "active",
  "owner": {
    "team": "traverse-core",
    "contact": "enrico.piovesan10@gmail.com"
  },
  "summary": "Deterministic quality and activity analysis of one WAV PCM16 recording, for an app state machine's analyzing state.",
  "description": "Analyzes one recording passed as {\"artifact_base64\": ...}, the exact input Traverse spec 139 FR-020 gives a state invoked with input_from host_connector_result.<artifact_ref>. The recording must be RIFF/WAVE 16-bit PCM, mono or stereo, 8-192 kHz, at most 8 MiB. It is cut into fixed 250 ms windows; each window is scored with audio.signal-quality-evaluate's metrics and the windows are merged into activity intervals by audio.activity-interval-classify (both reused as libraries, as is audio.wav-pcm16-decode's base64 and container validation). The result reports duration, format, overall RMS/peak/clipping (per mille of full scale), a quality_verdict and the intervals. A silent or clipped recording is a successful result with a verdict. Failures exit non-zero so the state machine takes capability_failed: status 10 analysis.unsupported_format, 11 analysis.input_limit_exceeded, 12 analysis.corrupt_input (Traverse's nested runtime keeps only the exit status, not stdout). Window size and thresholds are fixed and versioned as policy_version recording-analyze-1. Fuel: about 166 Traverse nested-runtime fuel units per input byte (1.86e9 for an 8 MiB recording); the stock 10M nested budget covers roughly 1.4 s of 16 kHz mono, so hosts analyzing real recordings must raise the nested fuel limit (#1656). Design: registry#594, decision-log entry 141.",
  "service_type": "stateless",
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "artifact_base64"
      ],
      "properties": {
        "artifact_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 11184812,
          "contentEncoding": "base64",
          "contentMediaType": "audio/wav",
          "description": "Strict padded base64 of one RIFF/WAVE PCM16 recording (mono or stereo, 8-192 kHz, at most 8 MiB)."
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": [
        "policy_version",
        "duration_ms",
        "sample_rate_hz",
        "channel_count",
        "rms_milli",
        "peak_milli",
        "clipping_ratio_milli",
        "quality_verdict",
        "window_ms",
        "window_count",
        "intervals"
      ],
      "properties": {
        "policy_version": {
          "const": "recording-analyze-1"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channel_count": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "rms_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "peak_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "clipping_ratio_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "quality_verdict": {
          "type": "string",
          "enum": [
            "usable",
            "silent",
            "clipped",
            "low_signal"
          ]
        },
        "window_ms": {
          "const": 250
        },
        "window_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2100
        },
        "intervals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "start_ms",
              "end_ms",
              "activity",
              "window_count"
            ],
            "properties": {
              "start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "end_ms": {
                "type": "integer",
                "minimum": 1
              },
              "activity": {
                "type": "string",
                "enum": [
                  "silence",
                  "possible-event",
                  "clipped"
                ]
              },
              "window_count": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "preconditions": [
    {
      "id": "wav-pcm16-recording",
      "description": "artifact_base64 is strict padded base64 of a RIFF/WAVE 16-bit PCM recording, mono or stereo, 8-192 kHz, at most 8 MiB. Other formats fail with exit status 10 (analysis.unsupported_format); larger recordings with 11 (analysis.input_limit_exceeded); malformed base64 or containers with 12 (analysis.corrupt_input)."
    },
    {
      "id": "nested-fuel-budget",
      "description": "The host's nested fuel budget covers the recording: about 166 fuel per input byte, up to 1.86e9 for 8 MiB. The stock 10M budget covers roughly 1.4 s of 16 kHz mono; beyond it the run fails as capability_failed with 'all fuel consumed'. Memory stays under the 32 MiB nested ceiling at the 8 MiB cap."
    }
  ],
  "postconditions": [
    {
      "id": "deterministic",
      "description": "Identical recordings produce identical output under policy recording-analyze-1."
    },
    {
      "id": "verdict-policy",
      "description": "quality_verdict is silent when every 250 ms window is quiet (rms under 5 per mille), clipped when at least half of the windows are clipped (10 per mille of samples at or above 32760), low_signal when under 10% of windows are active, and usable otherwise."
    },
    {
      "id": "intervals-cover-recording",
      "description": "Intervals are contiguous, merge adjacent windows of the same activity, start at 0 and end at duration_ms."
    },
    {
      "id": "failure-exit-status",
      "description": "Every failure writes {\"error\": \"analysis.<class>\"} and exits non-zero: 10 analysis.unsupported_format, 11 analysis.input_limit_exceeded, 12 analysis.corrupt_input, so an invoking state machine takes capability_failed."
    },
    {
      "id": "lossless-source",
      "description": "The recording is read but never modified or persisted."
    }
  ],
  "side_effects": [
    {
      "kind": "memory_only",
      "description": "Pure calculation over the supplied recording."
    }
  ],
