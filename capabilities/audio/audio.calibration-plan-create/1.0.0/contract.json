  "summary":"Create a bounded, connector-neutral audio calibration plan.",
  "description":"Pure planning for calibration of any audio input. It validates configurable targets and bounds without accessing a device, reading audio, persisting state, or assuming a domain, location, vendor, or operating system.",
  "use_cases":[
    {"scenario":"As an audio operator, I want a valid calibration policy represented as a portable plan so that a compatible audio-input host can measure it.","input_example":{"plan_id":"cal-001","target_level_dbfs":-18,"tolerance_db":3,"duration_seconds":10,"idempotency_key":"cal-001"},"output_example":{"connector_id":"traverse.audio-input","operation":"calibrate","plan_id":"cal-001","target_level_dbfs":-18,"tolerance_db":3,"duration_seconds":10,"idempotency_key":"cal-001","result_class":"planned"},"happy":true,"persona_ref":"audio-operator"},
    {"scenario":"As an audio operator, I want an unsafe target rejected before a host is invoked so that calibration remains bounded.","input_example":{"plan_id":"cal-invalid","target_level_dbfs":2,"tolerance_db":3,"duration_seconds":10,"idempotency_key":"cal-invalid"},"output_example":{"connector_id":"","operation":"","plan_id":"cal-invalid","target_level_dbfs":0,"tolerance_db":0,"duration_seconds":0,"idempotency_key":"","result_class":"target_out_of_bounds"},"happy":false,"persona_ref":"audio-operator"}
  ],
