{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "audio.activity-interval-classify",
  "namespace": "audio",
  "name": "activity-interval-classify",
  "version": "1.0.0",
  "lifecycle": "experimental",
  "owner": {
    "team": "callweave",
    "contact": "https://github.com/enricopiovesan"
  },
  "authoring": {
    "method": "llm-assisted",
    "source_revision": "35937ca",
    "test_evidence": "Callweave WASM build and direct WASI smoke test",
    "review": {
      "decision": "pending-qualified-review",
      "pr": "pending",
      "reviewer": "traverse-registry-maintainer"
    }
  },
  "summary": "Classify ordered quality windows into contiguous generic activity intervals.",
  "description": "Pure, taxonomy-neutral interval classification over quality facts. It preserves every input window exactly once and labels silence, background, possible-event, or clipped activity without naming a species or invoking a model.",
  "use_cases": [
    {
      "scenario": "As an audio-processing consumer, I want contiguous active and quiet intervals derived from quality windows so that model runners can process only relevant windows.",
      "input_example": {
        "policy": {
          "version": "activity-1"
        },
        "windows": [
          {
            "start_ms": 0,
            "end_ms": 1000,
            "state": "quiet"
          },
          {
            "start_ms": 1000,
            "end_ms": 2000,
            "state": "active"
          }
        ]
      },
      "output_example": {
        "represented_window_count": 2,
        "intervals": [
          {
            "start_ms": 0,
            "end_ms": 1000,
            "activity": "silence"
          },
          {
            "start_ms": 1000,
            "end_ms": 2000,
            "activity": "possible-event"
          }
        ]
      },
      "happy": true,
      "persona_ref": "audio-processing-consumer"
    },
    {
      "scenario": "As an audio-processing consumer, I want invalid or unknown quality states rejected so that no interval silently disappears.",
      "input_example": {
        "policy": {
          "version": "activity-1"
        },
        "windows": [
          {
            "start_ms": 1000,
            "end_ms": 0,
            "state": "unknown"
          }
        ]
      },
      "output_example": {
        "error": "invalid window interval"
      },
      "happy": false,
      "persona_ref": "audio-processing-consumer"
    },
    {
      "scenario": "As an audio-processing consumer, I want clipped windows represented explicitly so that corrupted signal is never mistaken for a possible event.",
      "input_example": {
        "policy": {
          "version": "activity-1"
        },
        "windows": [
          {
            "start_ms": 0,
            "end_ms": 1000,
            "state": "clipped"
          }
        ]
      },
      "output_example": {
        "represented_window_count": 1,
        "intervals": [
          {
            "start_ms": 0,
            "end_ms": 1000,
            "activity": "clipped",
            "window_count": 1
          }
        ]
      },
      "happy": false,
      "persona_ref": "audio-processing-consumer"
    }
  ],
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "windows",
        "policy"
      ],
      "properties": {
        "windows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": [
              "start_ms",
              "end_ms",
              "state"
            ],
            "properties": {
              "start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "end_ms": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "quiet",
                  "active",
                  "clipped"
                ]
              },
              "background_dominant": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "max_windows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "required": [
        "policy_version",
        "intervals",
        "represented_window_count"
      ],
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "represented_window_count": {
          "type": "integer"
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start_ms",
              "end_ms",
              "activity",
              "window_count"
            ],
            "properties": {
              "start_ms": {
                "type": "integer"
              },
              "end_ms": {
                "type": "integer"
              },
              "activity": {
                "type": "string",
                "enum": [
                  "silence",
                  "background",
                  "possible-event",
                  "clipped"
                ]
              },
              "window_count": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "preconditions": [
    {
      "id": "ordered-windows",
      "description": "Each window has a positive bounded interval and a recognized quality state."
    }
  ],
  "postconditions": [
    {
      "id": "lossless-coverage",
      "description": "Every input window is represented exactly once."
    },
    {
      "id": "deterministic",
      "description": "Identical windows and policy produce identical intervals."
    }
  ],
  "side_effects": [
    {
      "kind": "memory_only",
      "description": "Pure classification."
    }
  ],
