{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "audio.signal-quality-evaluate",
  "namespace": "audio",
  "name": "signal-quality-evaluate",
  "version": "1.0.0",
  "lifecycle": "experimental",
  "owner": {
    "team": "callweave",
    "contact": "https://github.com/enricopiovesan"
  },
  "authoring": {
    "method": "llm-assisted",
    "source_revision": "358857b",
    "test_evidence": "Callweave WASM build and direct WASI smoke test",
    "review": {
      "decision": "pending-qualified-review",
