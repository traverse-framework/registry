{
  "kind": "capability_contract",
  "schema_version": "1.0.0",
  "id": "model.execute",
  "namespace": "model",
  "name": "execute",
  "version": "1.0.0",
  "lifecycle": "active",
  "owner": {
    "team": "traverse-core",
    "contact": "https://github.com/enricopiovesan"
  },
  "summary": "Execute a signed exact-ref model package through traverse.model-runtime (Spec 138).",
  "description": "Catalog-facing shim over the traverse.model-runtime connector operation model.execute. Consumers supply an exact-ref model pin (model_id, version, digest), a host-staged input_ref, app-declared model_usage (commercial|non_commercial), and a trust_root of allowed signer key ids. The capability validates those inputs, dispatches via mediated connector_invoke, and surfaces the host's verified model_evidence on success. Fail-closed Spec 138 reasons (digest_mismatch, key_untrusted, signature_invalid, rights_mismatch, rights_policy_denied, usage_undeclared, package_revoked, model_unavailable) pass through unchanged. It does not fetch Hugging Face, hold signing keys, or select a model \u2014 the pin is consumer-supplied. The reference package for catalog demos is traverse.digits-onnx@1.0.0 from Traverse fixtures.",
  "use_cases": [
    {
      "scenario": "As an inference operator, I want a signed exact-ref digits-onnx package executed with declared non_commercial usage so that the host returns verified model_evidence without embedding a model in this capability.",
      "input_example": {
        "model_ref": {
          "model_id": "traverse.digits-onnx",
          "version": "1.0.0",
          "digest": "sha256:ecc32b909bd495c975e2c07a0f73ed85929026325bd8cf7865b9eec9293e03cb"
        },
        "input_ref": "host:input:digits-frame-1",
        "policy_ref": "policy:default-wasm-cpu",
        "data_classification": "public",
        "input_schema_ref": "schema:traverse-digits-onnx-in",
        "input_schema_version": "1.0.0",
        "max_output_bytes": 56,
        "model_usage": "non_commercial",
        "trust_root": {
          "allowed_signers": [
            "traverse-test-model-signing"
          ]
        }
      },
      "output_example": {
        "status": "ok",
        "output_ref": "host:output:digits-1",
        "output_schema_ref": "schema:traverse-digits-onnx-out",
        "model_ref": {
          "model_id": "traverse.digits-onnx",
          "version": "1.0.0",
          "digest": "sha256:ecc32b909bd495c975e2c07a0f73ed85929026325bd8cf7865b9eec9293e03cb"
        },
        "placement": "wasm-cpu",
        "result_class": "ok",
        "model_evidence": {
          "license_id": "CC-BY-4.0",
          "commercial_use": "allowed"
        }
      },
      "happy": true,
      "persona_ref": "inference-operator"
    },
    {
      "scenario": "As an inference operator, I want an omitted model_usage rejected with usage_undeclared so that undeclared commercial intent cannot silently proceed.",
      "input_example": {
        "model_ref": {
          "model_id": "traverse.digits-onnx",
          "version": "1.0.0",
          "digest": "sha256:ecc32b909bd495c975e2c07a0f73ed85929026325bd8cf7865b9eec9293e03cb"
        },
        "input_ref": "host:input:digits-frame-1",
        "policy_ref": "policy:default-wasm-cpu",
        "data_classification": "public",
        "input_schema_ref": "schema:traverse-digits-onnx-in",
        "input_schema_version": "1.0.0",
        "max_output_bytes": 56,
        "trust_root": {
          "allowed_signers": [
            "traverse-test-model-signing"
          ]
        }
      },
      "output_example": {
        "status": "error",
        "output_ref": "",
        "output_schema_ref": "",
        "model_ref": {
          "model_id": "",
          "version": "",
          "digest": ""
        },
        "placement": "",
        "result_class": "error",
        "reason": "usage_undeclared"
      },
      "happy": false,
      "persona_ref": "inference-operator"
    },
    {
      "scenario": "As an inference operator, I want an empty trust_root rejected with key_untrusted so that unsigned or untrusted packages cannot execute.",
      "input_example": {
        "model_ref": {
          "model_id": "traverse.digits-onnx",
          "version": "1.0.0",
          "digest": "sha256:ecc32b909bd495c975e2c07a0f73ed85929026325bd8cf7865b9eec9293e03cb"
        },
        "input_ref": "host:input:digits-frame-1",
        "policy_ref": "policy:default-wasm-cpu",
        "data_classification": "public",
        "input_schema_ref": "schema:traverse-digits-onnx-in",
        "input_schema_version": "1.0.0",
        "max_output_bytes": 56,
        "model_usage": "commercial",
        "trust_root": {
          "allowed_signers": []
        }
      },
      "output_example": {
        "status": "error",
        "output_ref": "",
        "output_schema_ref": "",
        "model_ref": {
          "model_id": "",
          "version": "",
          "digest": ""
        },
        "placement": "",
        "result_class": "error",
        "reason": "key_untrusted"
      },
      "happy": false,
      "persona_ref": "inference-operator"
    },
    {
      "scenario": "As an inference operator, I want a tampered package digest reported as digest_mismatch so that integrity failures stay fail-closed across hosts.",
      "input_example": {
        "model_ref": {
          "model_id": "traverse.digits-onnx",
          "version": "1.0.0",
          "digest": "sha256:ecc32b909bd495c975e2c07a0f73ed85929026325bd8cf7865b9eec9293e03cb"
