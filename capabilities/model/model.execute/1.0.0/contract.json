        "input_schema_version": "1.0.0",
        "max_output_bytes": 56,
        "model_usage": "non_commercial",
        "trust_root": {
          "allowed_signers": [
            "traverse-test-model-signing"
          ]
        }
      },
      "output_example": {
        "status": "error",
        "output_ref": "",
        "output_schema_ref": "",
        "model_ref": {
          "model_id": "",
          "version": "",
          "digest": ""
        },
        "placement": "",
        "result_class": "error",
        "reason": "digest_mismatch"
      },
      "happy": false,
      "persona_ref": "inference-operator",
      "connector_fixture": {
        "activated": true,
        "responses": [
          {
            "connector_id": "traverse.model-runtime",
            "operation": "model.execute",
            "body": {
              "abi_version": "1.0.0",
              "result_class": "model_unavailable",
              "payload": {
                "status": "error",
                "reason": "digest_mismatch"
              }
            }
          }
        ]
      }
    },
    {
      "scenario": "As an inference operator, I want a rights pin mismatch reported as rights_mismatch so that package rights cannot drift from the declared pin.",
      "input_example": {
        "model_ref": {
          "model_id": "traverse.digits-onnx",
          "version": "1.0.0",
          "digest": "sha256:ecc32b909bd495c975e2c07a0f73ed85929026325bd8cf7865b9eec9293e03cb"
        },
        "input_ref": "host:input:digits-frame-1",
        "policy_ref": "policy:default-wasm-cpu",
        "data_classification": "public",
        "input_schema_ref": "schema:traverse-digits-onnx-in",
        "input_schema_version": "1.0.0",
        "max_output_bytes": 56,
        "model_usage": "non_commercial",
        "trust_root": {
          "allowed_signers": [
            "traverse-test-model-signing"
          ]
        }
      },
      "output_example": {
        "status": "error",
        "output_ref": "",
        "output_schema_ref": "",
        "model_ref": {
          "model_id": "",
          "version": "",
          "digest": ""
        },
        "placement": "",
        "result_class": "error",
        "reason": "rights_mismatch"
      },
      "happy": false,
      "persona_ref": "inference-operator",
      "connector_fixture": {
