  "dependencies": [],
  "description": "Pure standalone retention-policy calculation. It classifies whether an asset must be held, retained, or is eligible for later action. It never reads, deletes, exports, or stores assets.",
  "emits": [],
  "event_trigger": null,
  "evidence": [],
  "execution": {
    "binary_format": "wasm",
    "constraints": {
      "filesystem_access": "none",
      "host_api_access": "none",
      "network_access": "forbidden"
    },
    "entrypoint": {
      "command": "run",
      "kind": "wasi-command"
    },
    "preferred_targets": [
      "local",
      "browser",
      "edge",
      "device"
    ]
  },
  "id": "retention.eligibility-classify",
  "inputs": {
    "schema": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "legal_hold": {
              "type": "boolean"
            },
            "reference_count": {
              "minimum": 0,
              "type": "integer"
            },
            "review_hold": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "reference_count",
            "legal_hold",
            "review_hold"
          ],
          "type": "object"
        },
        "retention_policy": {
          "additionalProperties": false,
