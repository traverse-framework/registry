            }
          },
          "required": [
            "version"
          ],
          "type": "object"
        }
      },
      "required": [
        "asset",
        "retention_policy"
      ],
      "type": "object"
    }
  },
  "kind": "capability_contract",
  "lifecycle": "active",
  "name": "eligibility-classify",
  "namespace": "retention",
  "outputs": {
    "schema": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "reason_code": {
