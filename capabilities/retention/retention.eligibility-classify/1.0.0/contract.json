    }
  ],
  "state_schema": null,
  "summary": "Classify asset retention eligibility from supplied dependency and hold facts.",
  "use_cases": [
    {
      "happy": true,
      "input_example": {
        "asset": {
          "id": "a-1",
          "legal_hold": true,
          "reference_count": 0,
          "review_hold": false
        },
        "retention_policy": {
          "version": "1.0.0"
        }
      },
      "output_example": {
        "asset_id": "a-1",
        "policy_version": "1.0.0",
        "reason_code": "legal_hold",
        "retention_state": "held"
      },
      "persona_ref": "retention-steward",
      "scenario": "As a retention steward, I want legal-held assets classified as held so that downstream systems never treat them as eligible for removal."
    },
    {
      "happy": true,
      "input_example": {
        "asset": {
          "id": "a-2",
          "legal_hold": false,
          "reference_count": 2,
          "review_hold": false
        },
        "retention_policy": {
          "version": "1.0.0"
        }
      },
      "output_example": {
        "asset_id": "a-2",
        "policy_version": "1.0.0",
        "reason_code": "active_reference",
        "retention_state": "retained"
      },
      "persona_ref": "retention-steward",
      "scenario": "As a retention steward, I want referenced assets classified as retained so that active dependencies preserve them."
    },
    {
      "happy": true,
      "input_example": {
        "asset": {
          "id": "a-3",
          "legal_hold": false,
          "reference_count": 0,
          "review_hold": false
        },
        "retention_policy": {
          "version": "1.0.0"
        }
      },
      "output_example": {
        "asset_id": "a-3",
        "policy_version": "1.0.0",
        "reason_code": "no_active_dependency",
        "retention_state": "eligible"
      },
      "persona_ref": "retention-steward",
      "scenario": "As a retention steward, I want unreferenced assets marked eligible rather than deleted so that removal remains a separate downstream decision."
    },
    {
      "happy": false,
      "input_example": {
        "asset": {
          "id": "a-4",
          "legal_hold": false,
          "reference_count": 0,
          "review_hold": true
        },
        "retention_policy": {
          "version": "1.0.0"
        }
      },
      "output_example": {
        "asset_id": "a-4",
        "policy_version": "1.0.0",
        "reason_code": "review_hold",
        "retention_state": "held"
      },
      "persona_ref": "retention-steward",
      "scenario": "As a retention steward, I want review-held assets classified as held so that review protection has the same precedence as a legal hold."
    }
  ],
  "version": "1.0.0"
}
