              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "state": {
              "enum": [
                "protected",
                "unknown",
                "blocked"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      },
      "required": [
        "cluster",
        "privacy",
        "policy"
      ],
      "type": "object"
    }
  },
  "kind": "capability_contract",
