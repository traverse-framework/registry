  "description": "Pure standalone review gate. It validates the cluster and policy envelope, denies review when privacy is not already protected, and returns only the supplied sanitized asset list when the gate is open. It does not create ZIP files, call an LMM, inspect local storage, or mutate knowledge.",
  "emits": [],
  "event_trigger": null,
  "evidence": [],
  "execution": {
    "binary_format": "wasm",
    "constraints": {
      "filesystem_access": "none",
      "host_api_access": "none",
      "network_access": "forbidden"
    },
    "entrypoint": {
      "command": "run",
      "kind": "wasi-command"
    },
    "preferred_targets": [
      "local",
      "browser",
      "edge",
      "device"
    ]
  },
  "id": "review.prepare",
  "inputs": {
    "schema": {
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "additionalProperties": true,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        },
        "policy": {
          "additionalProperties": false,
          "properties": {
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "version"
          ],
          "type": "object"
        },
        "privacy": {
          "additionalProperties": true,
          "properties": {
