    "spec_ref": "100-capability-package-authoring@1.0.0"
  },
  "schema_version": "1.0.0",
  "service_type": "stateless",
  "side_effects": [
    {
      "description": "Pure calculation; no host, network, filesystem, model, state, or workflow access.",
      "kind": "memory_only"
    }
  ],
  "state_schema": null,
  "summary": "Decide the next reviewed state from the current state and reviewer decision.",
  "use_cases": [
    {
      "happy": true,
      "input_example": {
        "current_state": "provisional",
        "policy": {
          "version": "review-policy-1"
        },
        "review_decision": "verify"
      },
      "output_example": {
        "next_state": "verified",
        "policy_version": "review-policy-1",
        "reason_code": "verified_from_provisional",
        "status": "applied"
      },
      "persona_ref": "review-consumer",
      "scenario": "As a review consumer, I want a provisional item verified only when the reviewer explicitly verifies it so that final acceptance remains governed."
    },
    {
      "happy": false,
      "input_example": {
        "current_state": "unknown",
        "policy": {
          "version": "review-policy-1"
        },
        "review_decision": "verify"
      },
      "output_example": {
        "error_code": "verify_requires_provisional",
        "error_message": "only provisional items may be verified",
        "policy_version": "review-policy-1",
        "status": "invalid_transition"
      },
      "persona_ref": "review-consumer",
      "scenario": "As a review consumer, I want a non-provisional item blocked from verification so that uncertain or rejected items cannot become verified by mistake."
    },
    {
      "happy": true,
      "input_example": {
        "current_state": "unknown",
        "policy": {
          "version": "review-policy-1"
        },
        "review_decision": "reject"
      },
      "output_example": {
        "next_state": "rejected",
        "policy_version": "review-policy-1",
        "reason_code": "rejected_by_reviewer",
        "status": "applied"
      },
      "persona_ref": "review-consumer",
      "scenario": "As a review consumer, I want a reject decision to produce a rejected state so that negative review outcomes remain explicit and traceable."
    },
    {
      "happy": true,
      "input_example": {
        "current_state": "surprising",
        "policy": {
          "version": "review-policy-1"
        },
        "review_decision": "provisional"
      },
      "output_example": {
        "next_state": "provisional",
        "policy_version": "review-policy-1",
        "reason_code": "provisional_by_reviewer",
        "status": "applied"
      },
      "persona_ref": "review-consumer",
      "scenario": "As a review consumer, I want a provisional decision to preserve a provisional state so that a reviewer can keep an item in bounded limbo without falsely rejecting it."
    },
    {
      "happy": false,
      "input_example": {
        "current_state": "rejected",
        "policy": {
          "version": "review-policy-1"
        },
        "review_decision": "reject"
      },
      "output_example": {
        "next_state": "rejected",
        "policy_version": "review-policy-1",
        "reason_code": "rejected_by_reviewer",
        "status": "applied"
      },
      "persona_ref": "review-consumer",
      "scenario": "As a review consumer, I want an already rejected item to remain rejected when the reviewer confirms rejection so that terminal negative outcomes stay explicit."
    }
  ],
  "version": "1.0.0"
}
