        "policy_version": "approval-policy-1",
        "proposal_id": "proposal-1",
        "reason": "human_approval_required"
      },
      "persona_ref": "approval-consumer",
      "scenario": "As an approval consumer, I want a deny decision to remain non-applied so that advisory suggestions cannot mutate durable state without approval."
