  "use_cases": [
    {
      "happy": true,
      "persona_ref": "compliance-officer",
      "scenario": "As a compliance officer, I want to put an approval policy into durable store, so that thresholds and required roles survive across sessions.",
      "input_example": {
        "action": "put",
        "policy": {
          "policy_id": "pol-1",
          "thresholds": {
            "confidence_min": "0.8",
            "amount_max": "10000"
          },
          "required_roles": [
            "approver",
            "auditor"
          ]
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "policy": {
          "policy_id": "pol-1",
          "thresholds": {
            "confidence_min": "0.8",
