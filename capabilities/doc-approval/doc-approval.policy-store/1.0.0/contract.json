  "summary": "Put, get, or delete a durable approval policy config via host managed state.",
  "description": "Stateful store for a single approval policy (policy_id, thresholds object, required_roles[]) persisted under the fixed state_schema key `policy` via traverse_host::{state_put,state_get,state_delete}. Resource identity lives inside the value. Does not emit events. Browser targets are excluded.",
  "emits": [],
  "side_effects": [
    {
      "description": "Reads and writes host DataStore persistence for key policy via state_get/state_put/state_delete",
      "kind": "memory_only"
    }
  ],
  "preconditions": [
    {
      "id": "action-present",
      "description": "action must be one of get, put, delete"
    },
    {
      "id": "put-policy-complete",
      "description": "put requires policy with non-empty policy_id, thresholds object, and required_roles array"
    }
  ],
  "risk": {
    "effect_class": "state_write",
    "determinism_class": "deterministic",
    "reliability": {
