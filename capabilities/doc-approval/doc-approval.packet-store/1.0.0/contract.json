  "use_cases": [
    {
      "happy": true,
      "persona_ref": "approvals-manager",
      "scenario": "As an approvals manager, I want to put an approval packet into durable store, so that reviewer assignments survive across sessions.",
      "input_example": {
        "action": "put",
        "packet": {
          "packet_id": "pkt-1",
          "document_id": "doc-9",
          "status": "pending",
          "reviewer_ids": [
            "rev-a",
            "rev-b"
          ]
        }
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "packet": {
          "packet_id": "pkt-1",
          "document_id": "doc-9",
          "status": "pending",
          "reviewer_ids": [
            "rev-a",
            "rev-b"
          ]
        },
        "evaluation_trace": [
          "put packet"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "approval-consumer",
      "scenario": "As an approval consumer, I want to get a previously stored approval packet, so that my workflow can render reviewers and status.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "found": true,
        "packet": {
          "packet_id": "pkt-1",
          "document_id": "doc-9",
          "status": "pending",
          "reviewer_ids": [
            "rev-a",
            "rev-b"
          ]
        },
        "evaluation_trace": [
          "got packet"
        ]
      }
    },
    {
      "happy": true,
      "persona_ref": "approvals-manager",
      "scenario": "As an approvals manager, I want to delete a stored approval packet, so that closed packets do not linger in managed state.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": true,
        "reason_code": "ok",
        "evaluation_trace": [
          "deleted packet"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "approval-consumer",
      "scenario": "As an approval consumer, I want get to fail closed when no packet exists, so that absent state is explicit.",
      "input_example": {
        "action": "get"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "not_found",
        "found": false,
        "evaluation_trace": [
          "packet absent"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "approvals-manager",
      "scenario": "As an approvals manager, I want put with an incomplete packet rejected, so that partial writes cannot corrupt the store.",
      "input_example": {
        "action": "put",
        "packet": {
          "packet_id": "pkt-1",
          "document_id": "",
          "status": "pending",
          "reviewer_ids": []
        }
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_input",
        "evaluation_trace": [
          "precondition failed: packet.packet_id/document_id/status/reviewer_ids required"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "compliance-officer",
      "scenario": "As a compliance officer, I want unknown actions rejected, so that clients cannot invent store verbs.",
      "input_example": {
        "action": "list"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "invalid_action",
        "evaluation_trace": [
          "action must be get, put, or delete"
        ]
      }
    },
    {
      "happy": false,
      "persona_ref": "compliance-officer",
      "scenario": "As a compliance officer, I want host persistence failures surfaced as host_error, so that callers can fail closed when DataStore is unavailable.",
      "input_example": {
        "action": "delete"
      },
      "output_example": {
        "accepted": false,
        "reason_code": "host_error",
        "evaluation_trace": [
          "state_delete failed"
        ]
      }
    }
  ]
