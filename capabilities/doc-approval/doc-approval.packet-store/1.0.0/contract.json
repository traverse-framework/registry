  "summary": "Put, get, or delete a durable approval packet via host managed state.",
  "description": "Stateful store for a single approval packet (packet_id, document_id, status, reviewer_ids[]) persisted under the fixed state_schema key `packet` via traverse_host::{state_put,state_get,state_delete}. Resource identity lives inside the value. Does not emit events. Browser targets are excluded.",
  "emits": [],
  "side_effects": [
    {
      "description": "Reads and writes host DataStore persistence for key packet via state_get/state_put/state_delete",
      "kind": "memory_only"
    }
  ],
  "preconditions": [
    {
      "id": "action-present",
      "description": "action must be one of get, put, delete"
    },
    {
      "id": "put-packet-complete",
      "description": "put requires packet with non-empty packet_id, document_id, status, and reviewer_ids array"
    }
  ],
  "risk": {
    "effect_class": "state_write",
    "determinism_class": "deterministic",
    "reliability": {
      "idempotency_required": true,
      "retryable": true,
      "compensation_available": false
    }
  },
