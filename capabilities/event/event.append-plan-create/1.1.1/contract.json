            "minLength": 1,
            "maxLength": 256
          }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    }
  },
  "outputs": {
    "schema": {
      "oneOf": [
