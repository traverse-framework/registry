  "summary": "Create a bounded append request for an opaque immutable event.",
  "description": "Pure event-envelope validation and append planning. It preserves the caller-supplied event payload reference, versioned type, aggregate reference, causal references, timestamp, and idempotency key. A generic event-store connector owns durable append, ordering, and replay behavior. This capability does not persist events or depend on any app/workflow/domain.",
  "use_cases": [
    {
      "scenario": "As an event producer, I want a validated immutable event envelope shaped into an append request so that different applications can use the same event-store connector.",
      "input_example": {
        "event_id": "event:42",
        "event_type": "record.transitioned",
        "schema_version": "1.0.0",
        "aggregate_ref": "record:17",
        "payload_ref": "artifact:sha256:abc",
        "occurred_at": "2026-09-14T12:00:00Z",
        "causation_refs": [
          "event:41"
        ],
        "idempotency_key": "event:42"
      },
      "output_example": {
        "connector_id": "traverse.event-store",
        "operation": "append",
        "event": {
          "event_id": "event:42",
          "event_type": "record.transitioned",
          "schema_version": "1.0.0",
          "aggregate_ref": "record:17",
          "payload_ref": "artifact:sha256:abc",
          "occurred_at": "2026-09-14T12:00:00Z",
          "causation_refs": [
            "event:41"
          ]
        },
        "idempotency_key": "event:42",
        "result_class": "planned"
      },
      "happy": true,
      "persona_ref": "record-operator"
    },
    {
      "scenario": "As an event producer, I want missing identity fields, malformed causal references, and oversized requests rejected before requesting persistence so that the host receives only bounded envelopes.",
      "input_example": {
        "event_id": "",
        "event_type": "record.transitioned",
        "schema_version": "1.0.0",
        "aggregate_ref": "record:17",
        "payload_ref": "artifact:sha256:abc",
        "occurred_at": "2026-09-14T12:00:00Z",
        "causation_refs": [],
        "idempotency_key": "event:42"
      },
      "output_example": {
        "result_class": "invalid_request"
      },
      "happy": false,
      "persona_ref": "record-operator"
    }
  ],
