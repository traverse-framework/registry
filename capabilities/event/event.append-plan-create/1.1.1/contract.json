  },
  "preconditions": [
    {
      "id": "event-envelope-identifiers",
      "description": "Event identity, event type/schema version, aggregate and payload references, occurrence time, and idempotency key are non-empty and bounded."
    },
    {
      "id": "bounded-causality",
      "description": "The causal-reference array contains at most 16 non-empty opaque references."
    }
  ],
  "postconditions": [
    {
      "id": "envelope-preserved",
      "description": "The planned append contains all supplied event identity, schema, aggregate, payload, occurrence, causality, and idempotency fields."
    },
    {
      "id": "no-persistence-side-effect",
      "description": "Only an append request is prepared; durability, ordering, and replay are owned by the event-store connector."
    }
  ],
  "side_effects": [
    {
      "kind": "memory_only",
      "description": "Pure bounded validation/planning; no host, network, filesystem, or persistent-state access."
    }
  ],
